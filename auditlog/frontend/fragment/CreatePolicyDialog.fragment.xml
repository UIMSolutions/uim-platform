<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">
  <Dialog id="createPolicyDialog" title="{i18n>newPolicy}" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4">
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{ui>/newPolicy/name}" maxLength="80"/>
      <Label text="{i18n>description}"/>
      <TextArea value="{ui>/newPolicy/description}" rows="2"/>
      <Label text="{i18n>colDays}"/>
      <StepInput value="{ui>/newPolicy/retentionDays}" min="1" max="3650" step="1"/>
      <Label text="{i18n>colCategories}"/>
      <MultiComboBox selectedKeys="{ui>/newPolicy/categories}" placeholder="{i18n>allCategories}">
        <core:Item key="securityEvents" text="{i18n>catSecurityEvents}"/>
        <core:Item key="configuration" text="{i18n>catConfiguration}"/>
        <core:Item key="dataAccess" text="{i18n>catDataAccess}"/>
        <core:Item key="dataModification" text="{i18n>catDataModification}"/>
      </MultiComboBox>
      <Label text="{i18n>colDefault}"/>
      <Switch state="{ui>/newPolicy/isDefault}"/>
    </form:SimpleForm>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press=".onSavePolicy"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelPolicy"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
