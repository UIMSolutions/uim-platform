<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>resolve}" contentWidth="30rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colGoldenRecord}" required="true"/>
      <RadioButtonGroup id="survivorGroup" buttons="{view>/form/resolve/candidates}" select=".onSurvivor">
        <RadioButton text="{view>recordId} ({view>score} %)" selected="{= %{view>recordId} === %{view>/form/resolve/survivorRecordId} }"/>
      </RadioButtonGroup>
      <Label text=""/>
      <CheckBox text="{i18n>mergeDuplicates}" selected="{view>/form/resolve/merge}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>resolve}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
