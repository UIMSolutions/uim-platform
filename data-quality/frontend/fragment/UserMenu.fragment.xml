<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <ActionSheet title="{session>/displayName}" showCancelButton="true" placement="Bottom">
    <Button text="{session>/user} · {session>/tenant}" icon="sap-icon://employee" enabled="false"/>
    <Button text="{i18n>changePassword}" icon="sap-icon://key" press=".onChangePassword" visible="{session>/loginRequired}"/>
    <Button text="{i18n>logout}" icon="sap-icon://log" press=".onLogout"/>
  </ActionSheet>
</core:FragmentDefinition>
