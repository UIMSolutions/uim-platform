<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>importCsv}" contentWidth="40rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3" labelSpanL="3">
      <Label text="{i18n>colDataset}" required="true"/>
      <Input value="{view>/form/importCsv/datasetId}" placeholder="customers"/>
      <Label text="{i18n>csv}" required="true"/>
      <TextArea value="{view>/form/importCsv/csv}" rows="10" width="100%" placeholder="{i18n>csvHint}"/>
      <Label text=""/>
      <CheckBox text="{i18n>createDataset}" selected="{view>/form/importCsv/createDataset}"/>
      <Label text=""/>
      <CheckBox text="{i18n>replaceExisting}" selected="{view>/form/importCsv/replaceExisting}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>import}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
