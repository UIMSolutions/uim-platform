<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>newJob}" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colDataset}" required="true"/>
      <ComboBox selectedKey="{view>/form/cleansingJob/datasetId}"
        items="{path: '/Datasets', parameters: {$select: 'id,name'}, templateShareable: false}"><core:Item key="{id}" text="{name}"/></ComboBox>
      <Label text="{i18n>rules}"/>
      <MultiComboBox selectedKeys="{path: 'view>/form/cleansingJob/ruleIds', formatter: '.formatter.keys'}" selectionFinish=".onJobRules"
        placeholder="{i18n>allActiveRules}" items="{path: '/CleansingRules', parameters: {$select: 'id,name'}, templateShareable: false}">
        <core:Item key="{id}" text="{name}"/>
      </MultiComboBox>
      <Label text=""/>
      <CheckBox text="{i18n>dryRun}" selected="{view>/form/cleansingJob/dryRun}"/>
      <Label text=""/>
      <CheckBox text="{i18n>revalidate}" selected="{view>/form/cleansingJob/revalidate}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
