<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>loginTitle}" contentWidth="24rem" escapeHandler=".onEscape" busy="{login>/busy}" busyIndicatorDelay="0"
    icon="sap-icon://locked">
    <MessageStrip text="{login>/error}" type="Error" showIcon="true" visible="{= !!%{login>/error} }" class="sapUiSmallMargin"/>
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>loginUser}" required="true"/>
      <Input value="{login>/username}" autocomplete="username" submit=".onLogin"/>
      <Label text="{i18n>loginPassword}" required="true"/>
      <Input value="{login>/password}" type="Password" autocomplete="current-password" submit=".onLogin"/>
      <Label text="{i18n>loginTenant}"/>
      <Input value="{login>/tenant}" placeholder="default" submit=".onLogin"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>login}" type="Emphasized" press=".onLogin"/></beginButton>
  </Dialog>
</core:FragmentDefinition>
