{
  "serviceName": "uim-datasphere",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8095,
  "storage": "file",
  "dataFile": "data/datasphere.json",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "odataPath": "/odata/v4/datasphere",
  "maxPageSize": 500,
  "maxRequestBytes": 4194304,
  "authMode": "jwt",
  "jwtSecret": "",
  "tokenTtlSeconds": 3600,
  "adminUser": "admin",
  "adminPassword": "",
  "passwordIterations": 120000,
  "maxFailedLogins": 5,
  "lockSeconds": 900,
  "minPasswordLength": 10,
  "enforceQuota": true,
  "runRetentionDays": 30,
  "maxSchedulerBatch": 100,
  "federatedRowEstimate": 10000,
  "frontendDir": "../frontend",
  "schedulerIntervalSeconds": 60,
  "purgeEveryRuns": 60,
  "workerTenants": ["default"],
  "processingMode": "simulate",
  "simulatedFailurePercent": 0
}
