<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{= %{view>/form/taskChain/edit} ? ${i18n>editTaskChain} : ${i18n>createTaskChain} }" contentWidth="40rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3" labelSpanL="3">
      <Label text="{i18n>colId}"/>
      <Input value="{view>/form/taskChain/id}" enabled="{= !%{view>/form/taskChain/edit} }" placeholder="{i18n>idGenerated}"/>
      <Label text="{i18n>colSpace}" required="true"/>
      <Select selectedKey="{view>/form/taskChain/spaceId}" forceSelection="false" enabled="{= !%{view>/form/taskChain/edit} }"
        items="{path: '/Spaces', parameters: {$orderby: 'name'}, templateShareable: false}">
        <core:Item key="{id}" text="{name} ({id})"/>
      </Select>
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/taskChain/name}"/>
      <Label text="{i18n>colStepsIds}"/>
      <TextArea value="{view>/form/taskChain/taskIds}" rows="4" width="100%" placeholder="replicate-orders&#10;load-orders-dach"/>
      <Label text="{i18n>onFailure}"/>
      <Select selectedKey="{view>/form/taskChain/failurePolicy}">
        <core:Item key="stop" text="{i18n>enum_stop}"/>
        <core:Item key="continue" text="{i18n>enum_continue}"/>
      </Select>
      <Label text="{i18n>colFrequency}"/>
      <Select selectedKey="{view>/form/taskChain/frequency}">
        <core:Item key="manual" text="{i18n>enum_manual}"/>
        <core:Item key="interval" text="{i18n>enum_interval}"/>
        <core:Item key="hourly" text="{i18n>enum_hourly}"/>
        <core:Item key="daily" text="{i18n>enum_daily}"/>
        <core:Item key="weekly" text="{i18n>enum_weekly}"/>
        <core:Item key="monthly" text="{i18n>enum_monthly}"/>
      </Select>
      <Label text="{i18n>colInterval}" visible="{= %{view>/form/taskChain/frequency} === 'interval' }"/>
      <StepInput value="{view>/form/taskChain/intervalMinutes}" min="5" max="10080" step="5" width="10rem" description="{i18n>minutes}" visible="{= %{view>/form/taskChain/frequency} === 'interval' }"/>
      <Label text="{i18n>colStart}"/>
      <Input value="{view>/form/taskChain/startAt}" placeholder="2026-12-01T02:00:00Z"/>
      <Label text="{i18n>colDescription}"/>
      <TextArea value="{view>/form/taskChain/description}" rows="2" width="100%"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
