/// Parsing of the string valued domain enumerations (case insensitive).
module uim.platform.ai_core.domain.enumerations.parse;

import std.traits : EnumMembers;
import std.uni : icmp;
import uim.platform.ai_core;

mixin(ShowModule!());

@safe:

/// All values of a string enum, in declaration order.
string[] domainEnumValues(E)() if (is(E : string) && is(E == enum)) {
  string[] values;
  static foreach (m; EnumMembers!E)
    values ~= cast(string) m;
  return values;
}

/// Parse a string enum value; throws AiCoreException.invalid.
E parseDomainEnum(E)(string text, string field = E.stringof) if (is(E : string) && is(E == enum)) {
  auto t = text.strip;
  static foreach (m; EnumMembers!E)
    if (icmp(cast(string) m, t) == 0)
      return m;
  throw AiCoreException.invalid("Invalid " ~ field ~ " '" ~ text ~ "' (allowed: " ~ domainEnumValues!E.join(", ") ~ ")");
}

/// Parse or fall back to a default (empty text → default).
E parseDomainEnumOr(E)(string text, E fallback, string field = E.stringof) if (is(E : string) && is(E == enum)) {
  return text.strip.length == 0 ? fallback : parseDomainEnum!E(text, field);
}

/// Parse, returning the fallback for unknown values (tolerant record reading).
E domainEnumOr(E)(string text, E fallback) if (is(E : string) && is(E == enum)) {
  try
    return parseDomainEnumOr!E(text, fallback);
  catch (AiCoreException)
    return fallback;
}

///
unittest {
  assert(parseDomainEnum!ExecutionStatus("running") == ExecutionStatus.running);
  assert(parseDomainEnum!ArtifactKind("MODEL") == ArtifactKind.model);
  assert(parseDomainEnumOr!TargetStatus("", TargetStatus.running) == TargetStatus.running);
  assert(domainEnumOr!ExecutionStatus("garbage", ExecutionStatus.unknown) == ExecutionStatus.unknown);
  assert(failsWith(AiCoreErrorKind.invalid, () { parseDomainEnum!ArtifactKind("picture"); }));
}
