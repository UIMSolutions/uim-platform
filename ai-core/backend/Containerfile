# Containerfile for Podman. Build context: the uim-platform repository root:
#   podman build -f ai-core/backend/Containerfile -t uim-platform/ai-core .
FROM dlang2/ldc-ubuntu:1.40.1 AS build
WORKDIR /build
COPY . .
WORKDIR /build/ai-core/backend
RUN dub build --build=release --config=defaultRun --compiler=ldc2 \
 && dub build --build=release --config=cli --compiler=ldc2

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false appuser && mkdir -p /data && chown appuser:appuser /data
WORKDIR /app
COPY --from=build /build/ai-core/backend/build/uim-ai-core-platform-service /build/ai-core/backend/build/uim-ai-core-cli ./
COPY --from=build /build/ai-core/backend/config ./config
COPY --from=build /build/ai-core/frontend ./frontend
USER appuser

EXPOSE 8090
ENV AICORE_HOST=0.0.0.0 \
    AICORE_PORT=8090 \
    AICORE_STORAGE=file \
    AICORE_DATA_FILE=/data/ai-core.json \
    AICORE_FRONTEND_DIR=/app/frontend
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8090/health || exit 1

CMD ["./uim-ai-core-platform-service"]
