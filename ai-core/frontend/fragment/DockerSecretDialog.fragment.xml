<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createDockerSecret}" contentWidth="34rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/dockerSecret/id}" placeholder="my-registry"/>
      <Label text="{i18n>colServer}" required="true"/>
      <Input value="{view>/form/dockerSecret/server}" placeholder="docker.io"/>
      <Label text="{i18n>colUser}" required="true"/>
      <Input value="{view>/form/dockerSecret/username}"/>
      <Label text="{i18n>colPassword}" required="true"/>
      <Input value="{view>/form/dockerSecret/password}" type="Password"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
