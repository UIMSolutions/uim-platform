<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createStoreSecret}" contentWidth="34rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colGroup}" required="true"/>
      <ComboBox selectedKey="{view>/form/storeSecret/resourceGroupId}"
        items="{path: '/ResourceGroups', templateShareable: false}"><core:Item key="{id}" text="{id}"/></ComboBox>
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/storeSecret/id}" placeholder="default"/>
      <Label text="{i18n>colType}"/>
      <Select selectedKey="{view>/form/storeSecret/type}">
        <core:Item key="S3" text="Amazon S3"/>
        <core:Item key="GCS" text="Google Cloud Storage"/>
        <core:Item key="AZURE" text="Azure Blob Storage"/>
        <core:Item key="WEBHDFS" text="WebHDFS"/>
      </Select>
      <Label text="{i18n>colBucket}" required="true"/>
      <Input value="{view>/form/storeSecret/bucket}"/>
      <Label text="{i18n>colEndpoint}"/>
      <Input value="{view>/form/storeSecret/endpoint}"/>
      <Label text="{i18n>colRegion}"/>
      <Input value="{view>/form/storeSecret/region}"/>
      <Label text="{i18n>colPathPrefix}"/>
      <Input value="{view>/form/storeSecret/pathPrefix}"/>
      <Label text="{i18n>colAccessKey}"/>
      <Input value="{view>/form/storeSecret/accessKeyId}"/>
      <Label text="{i18n>colSecretKey}"/>
      <Input value="{view>/form/storeSecret/secretAccessKey}" type="Password"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
