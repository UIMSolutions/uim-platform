<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createExecutable}" contentWidth="34rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colGroup}" required="true"/>
      <ComboBox selectedKey="{view>/form/executable/resourceGroupId}"
        items="{path: '/ResourceGroups', templateShareable: false}"><core:Item key="{id}" text="{id}"/></ComboBox>
      <Label text="{i18n>colScenario}" required="true"/>
      <ComboBox selectedKey="{view>/form/executable/scenarioId}"
        items="{path: '/Scenarios', templateShareable: false}"><core:Item key="{id}" text="{name} ({id})"/></ComboBox>
      <Label text="{i18n>colId}" required="true"/>
      <Input value="{view>/form/executable/id}" placeholder="trainer"/>
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/executable/name}"/>
      <Label text="{i18n>colType}"/>
      <SegmentedButton selectedKey="{view>/form/executable/type}">
        <items>
          <SegmentedButtonItem key="workflow" text="{i18n>typeWorkflow}"/>
          <SegmentedButtonItem key="serving" text="{i18n>typeServing}"/>
        </items>
      </SegmentedButton>
      <Label text="{i18n>colVersion}"/>
      <Input value="{view>/form/executable/versionId}"/>
      <Label text="{i18n>colParameters}"/>
      <TextArea value="{view>/form/executable/parameters}" rows="3" placeholder="{i18n>hintParameters}"/>
      <Label text="{i18n>colInputs}"/>
      <TextArea value="{view>/form/executable/inputArtifacts}" rows="2" placeholder="{i18n>hintSlots}"/>
      <Label text="{i18n>colOutputs}"/>
      <TextArea value="{view>/form/executable/outputArtifacts}" rows="2" placeholder="{i18n>hintSlots}"/>
      <Label text="{i18n>colDescription}"/>
      <Input value="{view>/form/executable/description}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
