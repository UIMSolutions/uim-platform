<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createScenario}" contentWidth="34rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colGroup}" required="true"/>
      <ComboBox selectedKey="{view>/form/scenario/resourceGroupId}"
        items="{path: '/ResourceGroups', templateShareable: false}"><core:Item key="{id}" text="{id}"/></ComboBox>
      <Label text="{i18n>colId}" required="true"/>
      <Input value="{view>/form/scenario/id}" placeholder="invoice-classification"/>
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/scenario/name}"/>
      <Label text="{i18n>colDescription}"/>
      <TextArea value="{view>/form/scenario/description}" rows="2"/>
      <Label text="{i18n>colLabels}"/>
      <TextArea value="{view>/form/scenario/labels}" rows="2" placeholder="{i18n>hintBindings}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
