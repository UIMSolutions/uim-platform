<mvc:View controllerName="uim.aicore.controller.Main"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
  height="100%">
  <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>appTitle}" level="H2"/></f:heading>
        <f:snappedContent><Text text="{i18n>appDescription}"/></f:snappedContent>
        <f:content>
          <ComboBox id="groupSelect" selectedKey="{view>/group}" selectionChange=".onGroupChange" showClearIcon="true"
            placeholder="{i18n>allGroups}" width="16rem"
            items="{path: '/ResourceGroups', parameters: {$orderby: 'id'}, templateShareable: false}">
            <core:Item key="{id}" text="{id}"/>
          </ComboBox>
        </f:content>
        <f:actions>
          <Button text="{i18n>reconcile}" icon="sap-icon://synchronize" press=".onReconcile"/>
          <Button id="seedButton" text="{i18n>seed}" icon="sap-icon://add-product" press=".onSeed"
            visible="{= %{/Statistics/resourceGroups} === 0 }"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <!-- KPI header bound to the Statistics singleton -->
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox id="kpis" binding="{/Statistics}" wrap="Wrap" class="sapUiSmallMarginBottom">
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiExecutions}"/>
            <ObjectNumber number="{runningExecutions}" unit="{i18n>kpiRunning} · {pendingExecutions} {i18n>kpiPending}" state="Information"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiCompleted}"/>
            <ObjectNumber number="{completedExecutions}" unit="· {failedExecutions} {i18n>kpiFailed}" state="Success"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiDeployments}"/>
            <ObjectNumber number="{runningDeployments}" unit="/ {deployments} {i18n>kpiRunning}" state="{= %{runningDeployments} > 0 ? 'Success' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiArtifacts}"/>
            <ObjectNumber number="{artifacts}" unit="· {models} {i18n>kpiModels} · {datasets} {i18n>kpiDatasets}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiCatalog}"/>
            <ObjectNumber number="{scenarios}" unit="{i18n>kpiScenarios} · {executables} {i18n>kpiExecutables} · {configurations} {i18n>kpiConfigurations}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSchedules}"/>
            <ObjectNumber number="{activeSchedules}" unit="/ {schedules} {i18n>kpiActive}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiMetrics}"/>
            <ObjectNumber number="{metrics}"/>
          </VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <!-- ── Executions ──────────────────────────────────────────── -->
          <IconTabFilter key="executions" icon="sap-icon://process" text="{i18n>tabExecutions}">
            <Table id="executionsTable" mode="SingleSelectLeft" growing="true" growingThreshold="25" noDataText="{i18n>noData}"
              items="{path: '/Executions', parameters: {$orderby: 'submissionTime desc', $count: true}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabExecutions}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch"><customData><core:CustomData key="table" value="executionsTable"/></customData></SearchField>
                  <Button text="{i18n>run}" type="Emphasized" icon="sap-icon://media-play" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="execution"/></customData></Button>
                  <Button text="{i18n>stop}" icon="sap-icon://stop" press=".onStop"><customData><core:CustomData key="table" value="executionsTable"/><core:CustomData key="action" value="StopExecution"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="executionsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colId}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConfiguration}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSubmitted}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colDuration}"/></Column>
                <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colMetrics}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onExecutionPress">
                  <ObjectIdentifier title="{id}" text="{scenarioId}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  <Text text="{configurationId}"/>
                  <Text text="{resourceGroupId}"/>
                  <Text text="{path: 'submissionTime', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'short'}}"/>
                  <Text text="{path: 'durationSeconds', formatter: '.formatter.duration'}"/>
                  <ObjectNumber number="{metricCount}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Deployments ─────────────────────────────────────────── -->
          <IconTabFilter key="deployments" icon="sap-icon://cloud" text="{i18n>tabDeployments}">
            <Table id="deploymentsTable" mode="SingleSelectLeft" growing="true" growingThreshold="25" noDataText="{i18n>noData}"
              items="{path: '/Deployments', parameters: {$orderby: 'submissionTime desc', $count: true}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabDeployments}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch"><customData><core:CustomData key="table" value="deploymentsTable"/></customData></SearchField>
                  <Button text="{i18n>deploy}" type="Emphasized" icon="sap-icon://upload-to-cloud" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="deployment"/></customData></Button>
                  <Button text="{i18n>stop}" icon="sap-icon://stop" press=".onStop"><customData><core:CustomData key="table" value="deploymentsTable"/><core:CustomData key="action" value="StopDeployment"/></customData></Button>
                  <Button text="{i18n>restart}" icon="sap-icon://restart" press=".onStop"><customData><core:CustomData key="table" value="deploymentsTable"/><core:CustomData key="action" value="ResumeDeployment"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="deploymentsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colId}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConfiguration}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colDeploymentUrl}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colTtl}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onDeploymentPress">
                  <ObjectIdentifier title="{id}" text="{scenarioId}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  <Text text="{configurationId}"/>
                  <Link text="{deploymentUrl}" href="{deploymentUrl}" target="_blank" wrapping="true"/>
                  <Text text="{resourceGroupId}"/>
                  <Text text="{path: 'ttlSeconds', formatter: '.formatter.ttl'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Scenarios ───────────────────────────────────────────── -->
          <IconTabFilter key="scenarios" icon="sap-icon://folder" text="{i18n>tabScenarios}">
            <Table id="scenariosTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/Scenarios', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabScenarios}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch"><customData><core:CustomData key="table" value="scenariosTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="scenario"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="scenariosTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colDescription}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
                <Column hAlign="End"><Text text="{i18n>kpiExecutables}"/></Column>
                <Column hAlign="End"><Text text="{i18n>kpiConfigurations}"/></Column>
                <Column hAlign="End"><Text text="{i18n>kpiArtifacts}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onScenarioPress">
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{description}" maxLines="2"/>
                  <Text text="{resourceGroupId}"/>
                  <ObjectNumber number="{executableCount}"/>
                  <ObjectNumber number="{configurationCount}"/>
                  <ObjectNumber number="{artifactCount}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Executables ─────────────────────────────────────────── -->
          <IconTabFilter key="executables" icon="sap-icon://source-code" text="{i18n>tabExecutables}">
            <Table id="executablesTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/Executables', parameters: {$orderby: 'scenarioId,name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabExecutables}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch"><customData><core:CustomData key="table" value="executablesTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="executable"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="executablesTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScenario}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colVersion}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colParameters}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colInputs}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colOutputs}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <ObjectStatus text="{path: 'type', formatter: '.formatter.enumText'}" icon="{path: 'type', formatter: '.formatter.typeIcon'}"/>
                  <Text text="{scenarioId}"/>
                  <Text text="{versionId}"/>
                  <Text text="{path: 'parameters', formatter: '.formatter.list'}"/>
                  <Text text="{path: 'inputArtifacts', formatter: '.formatter.list'}"/>
                  <Text text="{path: 'outputArtifacts', formatter: '.formatter.list'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Configurations ──────────────────────────────────────── -->
          <IconTabFilter key="configurations" icon="sap-icon://action-settings" text="{i18n>tabConfigurations}">
            <Table id="configurationsTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/Configurations', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabConfigurations}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch"><customData><core:CustomData key="table" value="configurationsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="configuration"/></customData></Button>
                  <Button text="{i18n>run}" icon="sap-icon://media-play" press=".onRunConfiguration"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="configurationsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colExecutable}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScenario}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colParameters}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colInputs}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <ObjectStatus text="{executableId}" icon="{path: 'executableType', formatter: '.formatter.typeIcon'}"/>
                  <Text text="{scenarioId}"/>
                  <Text text="{path: 'parameterBindings', formatter: '.formatter.list'}"/>
                  <Text text="{path: 'inputArtifactBindings', formatter: '.formatter.list'}"/>
                  <Text text="{resourceGroupId}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Artifacts ───────────────────────────────────────────── -->
          <IconTabFilter key="artifacts" icon="sap-icon://product" text="{i18n>tabArtifacts}">
            <Table id="artifactsTable" mode="SingleSelectLeft" growing="true" growingThreshold="25" noDataText="{i18n>noData}"
              items="{path: '/Artifacts', parameters: {$orderby: 'createdAt desc'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabArtifacts}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch"><customData><core:CustomData key="table" value="artifactsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="artifact"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="artifactsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colKind}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScenario}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colExecution}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{description}"/>
                  <ObjectStatus text="{path: 'kind', formatter: '.formatter.enumText'}" icon="{path: 'kind', formatter: '.formatter.kindIcon'}"/>
                  <Text text="{scenarioId}"/>
                  <Text text="{executionId}"/>
                  <Text text="{url}" wrapping="true"/>
                  <Text text="{resourceGroupId}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Schedules ───────────────────────────────────────────── -->
          <IconTabFilter key="schedules" icon="sap-icon://appointment-2" text="{i18n>tabSchedules}">
            <Table id="schedulesTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/ExecutionSchedules', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabSchedules}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="schedule"/></customData></Button>
                  <Button text="{i18n>runNow}" icon="sap-icon://media-play" press=".onTriggerSchedule"/>
                  <Button text="{i18n>deactivate}" icon="sap-icon://pause" press=".onSetStatus"><customData><core:CustomData key="status" value="INACTIVE"/><core:CustomData key="table" value="schedulesTable"/></customData></Button>
                  <Button text="{i18n>activate}" icon="sap-icon://play" press=".onSetStatus"><customData><core:CustomData key="status" value="ACTIVE"/><core:CustomData key="table" value="schedulesTable"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="schedulesTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column><Text text="{i18n>colCron}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConfiguration}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colNextRun}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastRun}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{resourceGroupId}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  <Text text="{cron}"/>
                  <Text text="{configurationId}"/>
                  <Text text="{path: 'nextRunAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'short'}}"/>
                  <Text text="{path: 'lastRunAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'short'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Resource groups ─────────────────────────────────────── -->
          <IconTabFilter key="groups" icon="sap-icon://group" text="{i18n>tabGroups}">
            <Table id="groupsTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/ResourceGroups', parameters: {$orderby: 'id'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabGroups}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="group"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDeleteGroup"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colGroup}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLabels}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colScenarios}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colExecutions}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colDeployments}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{statusMessage}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  <Text text="{path: 'labels', formatter: '.formatter.list'}"/>
                  <ObjectNumber number="{scenarioCount}"/>
                  <ObjectNumber number="{executionCount}"/>
                  <ObjectNumber number="{deploymentCount}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Secrets ─────────────────────────────────────────────── -->
          <IconTabFilter key="secrets" icon="sap-icon://key" text="{i18n>tabSecrets}">
            <Table id="dockerSecretsTable" mode="SingleSelectLeft" noDataText="{i18n>noData}"
              items="{path: '/DockerRegistrySecrets', parameters: {$orderby: 'id'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>dockerSecrets}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="dockerSecret"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="dockerSecretsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colServer}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colUser}"/></Column>
                <Column><Text text="{i18n>colCredentials}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{id}"/>
                  <Text text="{server}"/>
                  <Text text="{username}"/>
                  <ObjectStatus text="{credentialFingerprint}" icon="{= %{hasCredentials} ? 'sap-icon://locked' : 'sap-icon://unlocked' }"
                    state="{= %{hasCredentials} ? 'Success' : 'Warning' }"/>
                </ColumnListItem>
              </items>
            </Table>
            <Table id="storeSecretsTable" mode="SingleSelectLeft" noDataText="{i18n>noData}" class="sapUiMediumMarginTop"
              items="{path: '/ObjectStoreSecrets', parameters: {$orderby: 'id'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>storeSecrets}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="storeSecret"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="storeSecretsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colType}"/></Column>
                <Column><Text text="{i18n>colBucket}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colRegion}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
                <Column><Text text="{i18n>colCredentials}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{id}"/>
                  <Text text="{type}"/>
                  <Text text="{bucket}"/>
                  <Text text="{region}"/>
                  <Text text="{resourceGroupId}"/>
                  <ObjectStatus text="{credentialFingerprint}" icon="{= %{hasCredentials} ? 'sap-icon://locked' : 'sap-icon://unlocked' }"
                    state="{= %{hasCredentials} ? 'Success' : 'Warning' }"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
