<mvc:View controllerName="uim.aicore.controller.DeploymentDetail"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form"
  height="100%">
  <f:DynamicPage id="deploymentPage">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>tabDeployments}: {id}" level="H2"/></f:heading>
        <f:expandedContent>
          <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
            icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
        </f:expandedContent>
        <f:navigationActions>
          <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>cancel}" press=".onNavBack"/>
        </f:navigationActions>
        <f:actions>
          <Button text="{i18n>stop}" icon="sap-icon://stop" press=".onAction" enabled="{path: 'status', targetType: 'any', formatter: '.formatter.canStop'}">
            <customData><core:CustomData key="action" value="StopDeployment"/></customData>
          </Button>
          <Button text="{i18n>restart}" icon="sap-icon://restart" press=".onAction" enabled="{path: 'status', targetType: 'any', formatter: '.formatter.canRestart'}">
            <customData><core:CustomData key="action" value="ResumeDeployment"/></customData>
          </Button>
          <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" enabled="{path: 'status', targetType: 'any', formatter: '.formatter.canDelete'}"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:content>
      <VBox>
        <form:SimpleForm id="deploymentForm" title="{i18n>sectionGeneral}" editable="false" layout="ColumnLayout" columnsM="2" columnsL="3">
          <Label text="{i18n>colDeploymentUrl}"/><Link text="{deploymentUrl}" href="{deploymentUrl}" target="_blank" wrapping="true"/>
          <Label text="{i18n>colGroup}"/><Text text="{resourceGroupId}"/>
          <Label text="{i18n>colScenario}"/><Text text="{scenarioId}"/>
          <Label text="{i18n>colExecutable}"/><Text text="{executableId}"/>
          <Label text="{i18n>colConfiguration}"/><Text text="{configurationId}"/>
          <Label text="{i18n>colRunningConfiguration}"/><Text text="{= %{latestRunningConfigurationId} || '–' }"/>
          <Label text="{i18n>colTarget}"/><Text text="{path: 'targetStatus', formatter: '.formatter.enumText'}"/>
          <Label text="{i18n>colLastOperation}"/><Text text="{path: 'lastOperation', formatter: '.formatter.enumText'}"/>
          <Label text="{i18n>colStatusMessage}"/><Text text="{statusMessage}"/>
          <Label text="{i18n>colTtl}"/><Text text="{path: 'ttlSeconds', formatter: '.formatter.ttl'}"/>
          <Label text="{i18n>colStarted}"/><Text text="{path: 'startTime', type: 'sap.ui.model.odata.type.DateTimeOffset'}"/>
          <Label text="{i18n>colExpiresAt}"/><Text text="{path: 'expiresAt', type: 'sap.ui.model.odata.type.DateTimeOffset'}"/>
        </form:SimpleForm>

        <form:SimpleForm title="{i18n>sectionConfiguration}" editable="true" layout="ResponsiveGridLayout" labelSpanM="3">
          <Label text="{i18n>colConfiguration}"/>
          <Select id="configurationSelect" selectedKey="{view>/nextConfiguration}" forceSelection="false"
            items="{path: '/Configurations', parameters: {$orderby: 'name'}, suspended: true, templateShareable: false}">
            <core:Item key="{id}" text="{name} ({id})"/>
          </Select>
          <Label text=""/>
          <Button text="{i18n>applyConfiguration}" icon="sap-icon://upload-to-cloud" press=".onRollOut" width="12rem"/>
        </form:SimpleForm>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
