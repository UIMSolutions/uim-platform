{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": { "logoutEndpoint": "/do/logout" },
  "routes": [
    {
      "source": "^/odata/v4/catalog/(.*)$",
      "target": "/odata/v4/catalog/$1",
      "destination": "catalog-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": "$XSAPPNAME.Read"
    },
    {
      "source": "^/health$",
      "destination": "catalog-srv",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
