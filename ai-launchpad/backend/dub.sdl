name "ai-launchpad"
description "AI Launchpad service (SAP AI Launchpad style) — workspaces, connections to AI runtimes, resource groups, scenarios, configurations, executions, deployments, a model and dataset registry, the generative AI hub (prompt collections, prompts, playground), a launchpad of tiles and an administration with users, roles, audit log and tile catalog. D/vibe.d backend with REST, OData v4 (SAP Fiori), built-in JWT login, CLI and GtkD GUI"
homepage "https://github.com/UIMSolutions/uim-platform"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

targetPath "build"
sourcePaths "source"
importPaths "source"

// Shared platform library: generic OData v4 engine, document stores,
// security (HS256/RS256), configuration loader, CLI and GtkD entity browser.
dependency "uim-framework" version="~>26.11.3"  // 26.11.2 dropped uim.services, which ../../service needs
dependency "vibe-d" version="~>0.10.5"

buildRequirements "allowWarnings" "silenceDeprecations"

// ── HTTP server: REST (/api/v1/ai-launchpad) + OData v4 (/odata/v4/ai-launchpad) + Fiori (/app) + /auth ──
// dub build            (or --config=defaultRun)
// ./build/uim-ai-launchpad-platform-service
configuration "defaultRun" {
	targetType "executable"
	targetName "uim-ai-launchpad-platform-service"
	mainSourceFile "source/app.d"
	excludedSourceFiles "source/cli.d" "source/gui.d"
}

// ── Command line interface ──────────────────────────────────────────────────
// dub build --config=cli
// ./build/uim-ai-launchpad-cli help
configuration "cli" {
	targetType "executable"
	targetName "uim-ai-launchpad-cli"
	mainSourceFile "source/cli.d"
	excludedSourceFiles "source/app.d" "source/gui.d"
}

// ── Desktop GUI (GtkD 3 / GTK 3.24) ─────────────────────────────────────────
// dub build --config=gui
// ./build/uim-ai-launchpad-gui [--tenant=<id>] [--data-file=<path>]
configuration "gui" {
	targetType "executable"
	targetName "uim-ai-launchpad-gui"
	mainSourceFile "source/gui.d"
	excludedSourceFiles "source/app.d" "source/cli.d"
	dependency "gtk-d" version="~>3.11.0"
}

// ── Libraries / unit tests (dub test) ───────────────────────────────────────
configuration "defaultTest" {
	targetType "library"
	sourcePaths "tests"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}
