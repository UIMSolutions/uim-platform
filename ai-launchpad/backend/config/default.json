{
  "serviceName": "uim-ai-launchpad",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8097,
  "storage": "file",
  "dataFile": "data/ai-launchpad.json",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "odataPath": "/odata/v4/ai-launchpad",
  "maxPageSize": 500,
  "maxRequestBytes": 4194304,
  "authMode": "jwt",
  "jwtSecret": "",
  "tokenTtlSeconds": 3600,
  "adminUser": "admin",
  "adminPassword": "",
  "passwordIterations": 120000,
  "maxFailedLogins": 5,
  "lockSeconds": 900,
  "minPasswordLength": 10,
  "logRetentionDays": 30,
  "persistAuditLog": true,
  "maxReconcileBatch": 500,
  "frontendDir": "../frontend",
  "reconcileIntervalSeconds": 15,
  "purgeEveryRuns": 240,
  "workerTenants": ["default"],
  "runtimeMode": "simulate",
  "simulatedExecutionSeconds": 60,
  "simulatedDeploymentSeconds": 5,
  "simulatedFailurePercent": 0
}
