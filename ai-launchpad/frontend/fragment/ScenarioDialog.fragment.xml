<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{= %{view>/form/scenario/edit} ? ${i18n>editScenario} : ${i18n>createScenario} }" contentWidth="34rem" draggable="true" resizable="true">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colId}" required="true"/>
      <Input value="{view>/form/scenario/id}" enabled="{= !%{view>/form/scenario/edit} }" placeholder="{i18n>idScenario}"/>
      <Label text="{i18n>colConnection}" required="true"/>
      <Select selectedKey="{view>/form/scenario/connectionId}" enabled="{= !%{view>/form/scenario/edit} }" forceSelection="false"
        items="{path: '/Connections', parameters: {$orderby: 'name', $select: 'id,name'}, templateShareable: false}">
        <core:Item key="{id}" text="{name}"/>
      </Select>
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/scenario/name}"/>
      <Label text="{i18n>colExecutables}"/>
      <Input value="{view>/form/scenario/executables}" placeholder="training, serving"/>
      <Label text="{i18n>colLabels}"/>
      <TextArea value="{view>/form/scenario/labels}" rows="2" class="ailpMono"/>
      <Label text="{i18n>colDescription}"/>
      <TextArea value="{view>/form/scenario/description}" rows="3"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
