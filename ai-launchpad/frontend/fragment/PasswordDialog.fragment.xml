<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>changePassword}" contentWidth="26rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="5" labelSpanL="5">
      <Label text="{i18n>currentPassword}" required="true"/>
      <Input value="{view>/password/current}" type="Password" autocomplete="current-password"/>
      <Label text="{i18n>newPassword}" required="true"/>
      <Input value="{view>/password/next}" type="Password" autocomplete="new-password" placeholder="{i18n>passwordRule}"/>
      <Label text="{i18n>repeatPassword}" required="true"/>
      <Input value="{view>/password/repeat}" type="Password" autocomplete="new-password"
        valueState="{= %{view>/password/repeat} &amp;&amp; %{view>/password/repeat} !== %{view>/password/next} ? 'Error' : 'None' }"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSavePassword"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onClosePassword"/></endButton>
  </Dialog>
</core:FragmentDefinition>
