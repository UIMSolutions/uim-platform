<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>loginTitle}" contentWidth="24rem" escapeHandler=".onEscape" busy="{login>/busy}" busyIndicatorDelay="0"
    icon="sap-icon://locked" type="Standard">
    <VBox class="sapUiSmallMargin" alignItems="Center">
      <Image src="./css/logo.svg" width="3rem" height="3rem" alt="AI Launchpad"/>
      <Title text="{i18n>appTitle}" level="H2" class="sapUiTinyMarginTop"/>
      <Text text="{i18n>loginIntro}" textAlign="Center"/>
    </VBox>
    <MessageStrip text="{login>/error}" type="Error" showIcon="true" visible="{= !!%{login>/error} }" class="sapUiSmallMarginBeginEnd"/>
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4" labelSpanS="12">
      <Label text="{i18n>loginUser}" required="true"/>
      <Input id="loginUser" value="{login>/username}" autocomplete="username" submit=".onLogin"/>
      <Label text="{i18n>loginPassword}" required="true"/>
      <Input id="loginPassword" value="{login>/password}" type="Password" autocomplete="current-password" submit=".onLogin"/>
      <Label text="{i18n>loginTenant}" visible="{login>/showTenant}"/>
      <Input value="{login>/tenant}" placeholder="default" submit=".onLogin" visible="{login>/showTenant}"/>
    </form:SimpleForm>
    <buttons>
      <Button text="{i18n>otherTenant}" type="Transparent" press=".onToggleTenant" visible="{= !%{login>/showTenant} }"/>
      <Button id="loginButton" text="{i18n>login}" type="Emphasized" press=".onLogin"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
