<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{= %{view>/form/resourceGroup/edit} ? ${i18n>editResourceGroup} : ${i18n>createResourceGroup} }" contentWidth="34rem" draggable="true" resizable="true">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colId}" required="true"/>
      <Input value="{view>/form/resourceGroup/id}" enabled="{= !%{view>/form/resourceGroup/edit} }" placeholder="{i18n>idResourceGroup}"/>
      <Label text="{i18n>colConnection}" required="true"/>
      <Select selectedKey="{view>/form/resourceGroup/connectionId}" enabled="{= !%{view>/form/resourceGroup/edit} }" forceSelection="false"
        items="{path: '/Connections', parameters: {$orderby: 'name', $select: 'id,name'}, templateShareable: false}">
        <core:Item key="{id}" text="{name}"/>
      </Select>
      <Label text="{i18n>colDescription}"/>
      <Input value="{view>/form/resourceGroup/description}"/>
      <Label text="{i18n>colLabels}"/>
      <TextArea value="{view>/form/resourceGroup/labels}" rows="3" placeholder="ext.ai.sap.com/team=fraud" class="ailpMono"/>
      <Label text="{i18n>colStatus}"/>
      <Select selectedKey="{view>/form/resourceGroup/status}">
        <core:Item key="ready" text="{i18n>enum_ready}"/>
        <core:Item key="disabled" text="{i18n>enum_disabled}"/>
      </Select>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
