<mvc:View controllerName="uim.ailaunchpad.controller.Lifecycle"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
  <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>lifecycleTitle}" level="H2"/></f:heading>
        <f:snappedContent><Text text="{i18n>lifecycleDescription}"/></f:snappedContent>
        <f:actions>
          <Button id="reconcileButton" text="{i18n>reconcile}" icon="sap-icon://synchronize" press=".onReconcile"
            visible="{session>/canOperate}"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox binding="{/Statistics}" wrap="Wrap" class="ailpKpis">
          <VBox><Label text="{i18n>kpiScenarios}"/><ObjectNumber number="{scenarios}"/></VBox>
          <VBox><Label text="{i18n>kpiExecutions}"/>
            <ObjectNumber number="{runningExecutions}" unit="{i18n>kpiActive} · {failedExecutions} {i18n>kpiFailed}"
              state="{= %{failedExecutions} > 0 ? 'Error' : 'None' }"/></VBox>
          <VBox><Label text="{i18n>kpiDeployments}"/>
            <ObjectNumber number="{runningDeployments}" unit="/ {deployments} {i18n>kpiRunning}" state="Success"/></VBox>
          <VBox><Label text="{i18n>kpiModels}"/><ObjectNumber number="{models}"/></VBox>
          <VBox><Label text="{i18n>kpiDatasets}"/><ObjectNumber number="{datasets}"/></VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <!-- ── Scenarios ────────────────────────────────────────────── -->
          <IconTabFilter key="scenarios" icon="sap-icon://puzzle" text="{i18n>tabScenarios}" count="{/Statistics/scenarios}">
            <Table id="scenariosTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Scenarios', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabScenarios}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch" placeholder="{i18n>search}"><customData><core:CustomData key="table" value="scenariosTable"/></customData></SearchField>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canDevelop}"><customData><core:CustomData key="dialog" value="scenario"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="scenariosTable"/><core:CustomData key="dialog" value="scenario"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="scenariosTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConnection}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colExecutables}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colConfigurations}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>colExecutions}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>colDeployments}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{description}"/>
                  <Text text="{connectionName}"/>
                  <Text text="{executablesText}"/>
                  <ObjectNumber number="{configurationCount}"/>
                  <ObjectNumber number="{executionCount}"/>
                  <ObjectNumber number="{deploymentCount}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Configurations ───────────────────────────────────────── -->
          <IconTabFilter key="configurations" icon="sap-icon://action-settings" text="{i18n>tabConfigurations}"
            count="{/Statistics/configurations}">
            <Table id="configurationsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Configurations', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabConfigurations}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch" placeholder="{i18n>search}"><customData><core:CustomData key="table" value="configurationsTable"/></customData></SearchField>
                  <Button text="{i18n>startExecution}" icon="sap-icon://process" press=".onStartExecution" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="configurationsTable"/></customData></Button>
                  <Button text="{i18n>deploy}" icon="sap-icon://cloud" press=".onDeploy" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="configurationsTable"/></customData></Button>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canDevelop}"><customData><core:CustomData key="dialog" value="configuration"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="configurationsTable"/><core:CustomData key="dialog" value="configuration"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="configurationsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScenario}"/></Column>
                <Column><Text text="{i18n>colExecutable}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colParameters}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colInputArtifacts}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colUsage}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{scenarioName}"/>
                  <Text text="{executableId}"/>
                  <Text text="{parametersText}" class="ailpMono"/>
                  <Text text="{inputArtifactsText}" class="ailpMono"/>
                  <ObjectStatus text="{= %{inUse} ? ${i18n>inUse} + ' (' + %{executionCount} + ' / ' + %{deploymentCount} + ')' : ${i18n>notUsed} }"
                    state="{= %{inUse} ? 'Information' : 'None' }" icon="{= %{inUse} ? 'sap-icon://locked' : '' }"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Executions ───────────────────────────────────────────── -->
          <IconTabFilter key="executions" icon="sap-icon://process" text="{i18n>tabExecutions}" count="{/Statistics/executions}">
            <Table id="executionsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Executions', parameters: {$orderby: 'createdAt desc'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabExecutions}" level="H3"/>
                  <ToolbarSpacer/>
                  <SegmentedButton selectedKey="{view>/executionFilter}" selectionChange=".onExecutionFilter">
                    <items>
                      <SegmentedButtonItem key="" text="{i18n>all}"/>
                      <SegmentedButtonItem key="running" text="{i18n>enum_running}"/>
                      <SegmentedButtonItem key="completed" text="{i18n>enum_completed}"/>
                      <SegmentedButtonItem key="failed" text="{i18n>enum_failed}"/>
                    </items>
                  </SegmentedButton>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canOperate}"><customData><core:CustomData key="dialog" value="execution"/></customData></Button>
                  <Button text="{i18n>stop}" icon="sap-icon://stop" press=".onOperation" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="executionsTable"/><core:CustomData key="action" value="StopExecution"/><core:CustomData key="toast" value="stopped"/><core:CustomData key="confirm" value="confirmStop"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="executionsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colExecution}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConfiguration}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colResourceGroup}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colStartedAt}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colDuration}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{scenarioName}"/>
                  <Text text="{configurationName}"/>
                  <Text text="{resourceGroupId}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"
                    icon="{path: 'status', formatter: '.formatter.stateIcon'}" tooltip="{statusMessage}"/>
                  <Text text="{path: 'startedAt', formatter: '.formatter.dateTime'}"/>
                  <Text text="{path: 'durationSeconds', formatter: '.formatter.duration'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Deployments ──────────────────────────────────────────── -->
          <IconTabFilter key="deployments" icon="sap-icon://cloud" text="{i18n>tabDeployments}" count="{/Statistics/deployments}">
            <Table id="deploymentsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Deployments', parameters: {$orderby: 'createdAt desc'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabDeployments}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canOperate}"><customData><core:CustomData key="dialog" value="deployment"/></customData></Button>
                  <Button text="{i18n>scale}" icon="sap-icon://resize-horizontal" press=".onEdit" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="deploymentsTable"/><core:CustomData key="dialog" value="deployment"/></customData></Button>
                  <Button text="{i18n>start}" icon="sap-icon://play" press=".onOperation" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="deploymentsTable"/><core:CustomData key="action" value="StartDeployment"/><core:CustomData key="toast" value="started"/></customData></Button>
                  <Button text="{i18n>stop}" icon="sap-icon://stop" press=".onOperation" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="deploymentsTable"/><core:CustomData key="action" value="StopDeployment"/><core:CustomData key="toast" value="stopped"/><core:CustomData key="confirm" value="confirmStop"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canOperate}"><customData><core:CustomData key="table" value="deploymentsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colDeployment}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConfiguration}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colInferenceUrl}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colReplicas}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colExpiresAt}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{scenarioName}"/>
                  <Text text="{configurationName}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"
                    icon="{path: 'status', formatter: '.formatter.stateIcon'}" tooltip="{statusMessage}"/>
                  <Link text="{deploymentUrl}" href="{deploymentUrl}" target="_blank" wrapping="true"/>
                  <Text text="{minReplicas} – {maxReplicas}"/>
                  <Text text="{path: 'expiresAt', formatter: '.formatter.dateTime'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Models ───────────────────────────────────────────────── -->
          <IconTabFilter key="models" icon="sap-icon://machine" text="{i18n>tabModels}" count="{/Statistics/models}">
            <Table id="modelsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Models', parameters: {$orderby: 'name,version'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabModels}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch" placeholder="{i18n>search}"><customData><core:CustomData key="table" value="modelsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canDevelop}"><customData><core:CustomData key="dialog" value="model"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="modelsTable"/><core:CustomData key="dialog" value="model"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="modelsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colVersion}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScenario}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colSize}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{description}"/>
                  <Text text="{version}"/>
                  <Text text="{scenarioName}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"/>
                  <Text text="{url}" class="ailpMono" wrapping="true"/>
                  <ObjectNumber number="{path: 'sizeMiB', formatter: '.formatter.decimal'}" unit="MiB"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Datasets ─────────────────────────────────────────────── -->
          <IconTabFilter key="datasets" icon="sap-icon://database" text="{i18n>tabDatasets}" count="{/Statistics/datasets}">
            <Table id="datasetsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Datasets', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabDatasets}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch" placeholder="{i18n>search}"><customData><core:CustomData key="table" value="datasetsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canDevelop}"><customData><core:CustomData key="dialog" value="dataset"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="datasetsTable"/><core:CustomData key="dialog" value="dataset"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canDevelop}"><customData><core:CustomData key="table" value="datasetsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScenario}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colSize}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{scenarioName}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"/>
                  <Text text="{url}" class="ailpMono" wrapping="true"/>
                  <ObjectNumber number="{path: 'sizeMiB', formatter: '.formatter.decimal'}" unit="MiB"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
