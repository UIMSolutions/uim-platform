<mvc:View controllerName="uim.ailaunchpad.controller.Runtimes"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" height="100%">
  <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>runtimesTitle}" level="H2"/></f:heading>
        <f:snappedContent><Text text="{i18n>runtimesDescription}"/></f:snappedContent>
        <f:actions>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox binding="{/Statistics}" wrap="Wrap" class="ailpKpis">
          <VBox><Label text="{i18n>kpiWorkspaces}"/><ObjectNumber number="{workspaces}"/></VBox>
          <VBox><Label text="{i18n>kpiConnections}"/>
            <ObjectNumber number="{activeConnections}" unit="/ {connections} {i18n>kpiActive}"
              state="{= %{activeConnections} &lt; %{connections} ? 'Warning' : 'Success' }"/></VBox>
          <VBox><Label text="{i18n>kpiResourceGroups}"/><ObjectNumber number="{resourceGroups}"/></VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <!-- ── Workspaces ───────────────────────────────────────────── -->
          <IconTabFilter key="workspaces" icon="sap-icon://group-2" text="{i18n>tabWorkspaces}" count="{/Statistics/workspaces}">
            <Table id="workspacesTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Workspaces', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabWorkspaces}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch" placeholder="{i18n>search}">
                    <customData><core:CustomData key="table" value="workspacesTable"/></customData>
                  </SearchField>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}">
                    <customData><core:CustomData key="dialog" value="workspace"/></customData>
                  </Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="workspacesTable"/><core:CustomData key="dialog" value="workspace"/></customData>
                  </Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="workspacesTable"/></customData>
                  </Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colConnections}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colPromptCollections}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colDescription}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"/>
                  <ObjectNumber number="{connectionCount}"/>
                  <ObjectNumber number="{promptCollectionCount}"/>
                  <Text text="{description}" maxLines="2"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Connections ──────────────────────────────────────────── -->
          <IconTabFilter key="connections" icon="sap-icon://connected" text="{i18n>tabConnections}" count="{/Statistics/connections}">
            <Table id="connectionsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/Connections', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabConnections}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch" placeholder="{i18n>search}">
                    <customData><core:CustomData key="table" value="connectionsTable"/></customData>
                  </SearchField>
                  <Button id="validateButton" text="{i18n>validate}" icon="sap-icon://validate" press=".onOperation"
                    visible="{session>/canOperate}">
                    <customData><core:CustomData key="table" value="connectionsTable"/><core:CustomData key="action" value="ValidateConnection"/><core:CustomData key="toast" value="validated"/></customData>
                  </Button>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}">
                    <customData><core:CustomData key="dialog" value="connection"/></customData>
                  </Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="connectionsTable"/><core:CustomData key="dialog" value="connection"/></customData>
                  </Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="connectionsTable"/></customData>
                  </Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colWorkspace}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colValidatedAt}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{path: 'connectionType', formatter: '.formatter.enumText'}"/>
                  <Text text="{url}" class="ailpMono" wrapping="true"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"
                    icon="{path: 'status', formatter: '.formatter.stateIcon'}" tooltip="{statusMessage}"/>
                  <Text text="{workspaceName}"/>
                  <Text text="{path: 'lastValidatedAt', formatter: '.formatter.relativeTime'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Resource groups ──────────────────────────────────────── -->
          <IconTabFilter key="resource-groups" icon="sap-icon://folder-full" text="{i18n>tabResourceGroups}" count="{/Statistics/resourceGroups}">
            <Table id="resourceGroupsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noData}"
              items="{path: '/ResourceGroups', parameters: {$orderby: 'id'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabResourceGroups}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}">
                    <customData><core:CustomData key="dialog" value="resourceGroup"/></customData>
                  </Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="resourceGroupsTable"/><core:CustomData key="dialog" value="resourceGroup"/></customData>
                  </Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="resourceGroupsTable"/></customData>
                  </Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colResourceGroup}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colConnection}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLabels}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colActiveWorkloads}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{description}"/>
                  <Text text="{connectionName}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.state'}"/>
                  <Text text="{labelsText}" class="ailpMono"/>
                  <ObjectNumber number="{= %{activeExecutions} + %{activeDeployments} }"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
