<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog id="bindingDialog" title="{i18n>createBinding}" contentWidth="28rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/newBinding/name}" placeholder="my-app-key"/>
      <Label text="{i18n>colInstance}" required="true"/>
      <Select forceSelection="false" selectedKey="{view>/newBinding/instanceId}"
        items="{path: '/ServiceInstances', parameters: {$filter: 'status eq \'created\'', $orderby: 'name'}}">
        <core:Item key="{id}" text="{name}"/>
      </Select>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>createBinding}" type="Emphasized" press=".onCreateBinding"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
