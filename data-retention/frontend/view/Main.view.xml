<mvc:View controllerName="uim.dataretention.controller.Main"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
  height="100%">
  <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>appTitle}" level="H2"/></f:heading>
        <f:snappedContent><Text text="{i18n>appDescription}"/></f:snappedContent>
        <f:content>
          <ComboBox id="groupFilter" selectedKey="{view>/group}" selectionChange=".onFilter" showClearIcon="true"
            placeholder="{i18n>allGroups}" width="16rem"
            items="{path: '/ApplicationGroups', parameters: {$orderby: 'name', $select: 'id,name'}, templateShareable: false}">
            <core:Item key="{id}" text="{name}"/>
          </ComboBox>
        </f:content>
        <f:actions>
          <Button id="checkButton" text="{i18n>checkEndOfPurpose}" type="Emphasized" icon="sap-icon://inspection" press=".onOpenDialog"
            visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="check"/></customData></Button>
          <Button text="{i18n>simulate}" icon="sap-icon://simulate" press=".onSimulate"/>
          <Button id="seedButton" text="{i18n>seed}" icon="sap-icon://add-product" press=".onSeed"
            visible="{= %{/Statistics/applicationGroups} === 0 &amp;&amp; %{session>/canManage} }"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
          <Button id="userButton" icon="sap-icon://person-placeholder" text="{session>/displayName}" type="Transparent"
            press=".onUserMenu" visible="{session>/authenticated}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <!-- KPI header bound to the Statistics singleton -->
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox id="kpis" binding="{/Statistics}" wrap="Wrap" alignItems="Center" class="sapUiSmallMarginBottom">
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSubjects}"/>
            <ObjectNumber number="{dataSubjects}" unit="· {activeSubjects} {i18n>kpiActive} · {blockedSubjects} {i18n>kpiBlocked} · {deletedSubjects} {i18n>kpiDestroyed}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiDueBlocking}"/>
            <ObjectNumber number="{dueForBlocking}" state="{= %{dueForBlocking} > 0 ? 'Warning' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiDueDestruction}"/>
            <ObjectNumber number="{dueForDestruction}" unit="· {markedForDeletion} {i18n>kpiMarked}"
              state="{= %{dueForDestruction} > 0 ? 'Error' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiLegalHolds}"/>
            <ObjectNumber number="{legalHolds}" state="{= %{legalHolds} > 0 ? 'Information' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiRequests}"/>
            <ObjectNumber number="{pendingRequests}" unit="{i18n>kpiPending} · {rejectedRequests} {i18n>kpiRejected}"
              state="{= %{pendingRequests} > 0 ? 'Warning' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiJobs}"/>
            <ObjectNumber number="{scheduledJobs}" unit="{i18n>kpiScheduled} · {failedJobs} {i18n>kpiFailed}"
              state="{= %{failedJobs} > 0 ? 'Error' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiPurposes}"/>
            <ObjectNumber number="{activeBusinessPurposes}" unit="/ {businessPurposes} {i18n>kpiActive}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiNextEnd}"/>
            <Text text="{path: 'nextEndOfRetention', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"/>
          </VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <!-- ── Data subjects ───────────────────────────────────────── -->
          <IconTabFilter key="subjects" icon="sap-icon://group" text="{i18n>tabSubjects}" count="{/Statistics/dataSubjects}">
            <Table id="subjectsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noSubjects}"
              items="{path: '/DataSubjects', parameters: {$orderby: 'externalId', $count: true, $select: 'legalHoldReason,applicationGroupId,daysToEndOfRetention,retentionReason'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabSubjects}" level="H3"/>
                  <ToolbarSpacer/>
                  <SegmentedButton selectedKey="{view>/lifecycle}" selectionChange=".onLifecycleFilter">
                    <items>
                      <SegmentedButtonItem key="" text="{i18n>all}"/>
                      <SegmentedButtonItem key="active" icon="sap-icon://employee" tooltip="{i18n>lcActive}"/>
                      <SegmentedButtonItem key="blocked" icon="sap-icon://locked" tooltip="{i18n>lcBlocked}"/>
                      <SegmentedButtonItem key="archived" icon="sap-icon://attachment-zip-file" tooltip="{i18n>lcArchived}"/>
                      <SegmentedButtonItem key="markedForDeletion" icon="sap-icon://delete" tooltip="{i18n>lcMarked}"/>
                      <SegmentedButtonItem key="deleted" icon="sap-icon://decline" tooltip="{i18n>lcDeleted}"/>
                    </items>
                  </SegmentedButton>
                  <SearchField width="12rem" search=".onSearch"><customData><core:CustomData key="table" value="subjectsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="dataSubject"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="subjectsTable"/><core:CustomData key="dialog" value="dataSubject"/></customData></Button>
                  <Button text="{i18n>block}" icon="sap-icon://locked" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="subjectsTable"/><core:CustomData key="action" value="BlockDataSubject"/><core:CustomData key="toast" value="subjectChanged"/></customData></Button>
                  <Button text="{i18n>legalHold}" icon="sap-icon://official-service" press=".onLegalHold" visible="{session>/canManage}"/>
                  <Button text="{i18n>requestDeletion}" icon="sap-icon://eraser" press=".onRequestDeletion" visible="{session>/canManage}"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="subjectsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colSubject}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colPurpose}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colReferenceDate}"/></Column>
                <Column><Text text="{i18n>colLifecycle}"/></Column>
                <Column><Text text="{i18n>colPhase}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colEndOfPurpose}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colEndOfRetention}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{externalId}" text="{displayName}"/>
                  <ObjectIdentifier title="{businessPurposeId}" text="{governingLegalGroundName}"/>
                  <Text text="{path: 'referenceDate', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"/>
                  <VBox>
                    <ObjectStatus text="{path: 'lifecycleStatus', formatter: '.formatter.enumText'}" state="{path: 'lifecycleStatus', formatter: '.formatter.lifecycleState'}"
                      icon="{path: 'lifecycleStatus', formatter: '.formatter.lifecycleIcon'}"/>
                    <ObjectStatus text="{i18n>legalHold}" icon="sap-icon://official-service" state="Information" visible="{legalHold}" tooltip="{legalHoldReason}"/>
                  </VBox>
                  <ObjectStatus text="{path: 'phase', formatter: '.formatter.enumText'}" state="{path: 'phase', formatter: '.formatter.phaseState'}"
                    icon="{path: 'phase', formatter: '.formatter.phaseIcon'}" tooltip="{retentionReason}"/>
                  <Text text="{path: 'endOfPurpose', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"/>
                  <ObjectStatus text="{path: 'endOfRetention', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"
                    state="{path: 'daysToEndOfRetention', formatter: '.formatter.daysState'}"
                    tooltip="{path: 'daysToEndOfRetention', formatter: '.formatter.days'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Deletion requests ───────────────────────────────────── -->
          <IconTabFilter key="requests" icon="sap-icon://eraser" text="{i18n>tabRequests}" count="{/Statistics/pendingRequests}">
            <Table id="requestsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noRequests}"
              items="{path: '/DeletionRequests', parameters: {$orderby: 'createdAt desc', $count: true}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabRequests}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="deletionRequest"/></customData></Button>
                  <Button text="{i18n>process}" icon="sap-icon://process" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="requestsTable"/><core:CustomData key="action" value="ProcessDeletionRequest"/><core:CustomData key="toast" value="requestProcessed"/></customData></Button>
                  <Button text="{i18n>cancelRequest}" icon="sap-icon://cancel" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="requestsTable"/><core:CustomData key="action" value="CancelDeletionRequest"/><core:CustomData key="toast" value="requestProcessed"/></customData></Button>
                  <Button text="{i18n>processAll}" icon="sap-icon://media-play" press=".onProcessPending" visible="{session>/canManage}"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="requestsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colSubject}"/></Column>
                <Column><Text text="{i18n>colAction}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colReason}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colResult}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colEarliestDeletion}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{dataSubjectId}" text="{applicationGroupId}"/>
                  <Text text="{path: 'action', formatter: '.formatter.enumText'}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  <Text text="{reason}" wrapping="true"/>
                  <Text text="{resultMessage}" wrapping="true"/>
                  <Text text="{path: 'earliestDeletion', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'medium'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Archiving jobs ──────────────────────────────────────── -->
          <IconTabFilter key="jobs" icon="sap-icon://attachment-zip-file" text="{i18n>tabJobs}" count="{/Statistics/scheduledJobs}">
            <Table id="jobsTable" mode="SingleSelectLeft" growing="true" growingThreshold="25" noDataText="{i18n>noJobs}"
              items="{path: '/ArchivingJobs', parameters: {$orderby: 'scheduledAt desc', $count: true}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabJobs}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>newJob}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="archivingJob"/></customData></Button>
                  <Button text="{i18n>runNow}" icon="sap-icon://process" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="jobsTable"/><core:CustomData key="action" value="RunArchivingJob"/><core:CustomData key="toast" value="jobRun"/></customData></Button>
                  <Button text="{i18n>cancelJob}" icon="sap-icon://cancel" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="jobsTable"/><core:CustomData key="action" value="CancelArchivingJob"/><core:CustomData key="toast" value="jobRun"/></customData></Button>
                  <Button text="{i18n>runDue}" icon="sap-icon://media-play" press=".onRunDue" visible="{session>/canManage}"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="jobsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colJob}"/></Column>
                <Column><Text text="{i18n>colOperation}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScheduledAt}"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colResults}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLog}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{applicationGroupId}"/>
                  <ObjectIdentifier title="{path: 'operation', formatter: '.formatter.enumText'}" text="{= %{dryRun} ? ${i18n>dryRun} : '' }"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}" tooltip="{errorMessage}"/>
                  <Text text="{path: 'scheduledAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'short'}}"/>
                  <Text text="{archived} {i18n>archivedShort} · {destroyed} {i18n>destroyedShort} · {skipped} {i18n>skippedShort}"/>
                  <Text text="{logText}" maxLines="3" wrapping="true"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Business purposes ───────────────────────────────────── -->
          <IconTabFilter key="purposes" icon="sap-icon://course-program" text="{i18n>tabPurposes}">
            <Table id="purposesTable" mode="SingleSelectLeft" growing="true" growingThreshold="25" noDataText="{i18n>noPurposes}"
              items="{path: '/BusinessPurposes', parameters: {$orderby: 'name', $count: true, $select: 'description,legalEntityId'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabPurposes}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="businessPurpose"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="purposesTable"/><core:CustomData key="dialog" value="businessPurpose"/></customData></Button>
                  <Button text="{i18n>activate}" icon="sap-icon://play" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="purposesTable"/><core:CustomData key="action" value="ActivateBusinessPurpose"/><core:CustomData key="toast" value="statusChanged"/></customData></Button>
                  <Button text="{i18n>deactivate}" icon="sap-icon://pause" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="purposesTable"/><core:CustomData key="action" value="DeactivateBusinessPurpose"/><core:CustomData key="toast" value="statusChanged"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="purposesTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colPurpose}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colGroup}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colRole}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colRules}"/></Column>
                <Column hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colSubjects}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onPurposePress">
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{applicationGroupId}"/>
                  <Text text="{dataSubjectRoleId}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                    icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  <Text text="{rulesText}" wrapping="true"/>
                  <ObjectNumber number="{dataSubjectCount}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Master data ─────────────────────────────────────────── -->
          <IconTabFilter key="masterData" icon="sap-icon://database" text="{i18n>tabMasterData}">
            <Table id="groupsTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/ApplicationGroups', parameters: {$orderby: 'name', $select: 'description,applicationIds'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>applicationGroups}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="applicationGroup"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="groupsTable"/><core:CustomData key="dialog" value="applicationGroup"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="groupsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colGroup}"/></Column>
                <Column><Text text="{i18n>colScope}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colApplications}"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colPurposes}"/></Column>
                <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSubjects}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colActive}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{path: 'scope', formatter: '.formatter.enumText'}"/>
                  <Text text="{applicationsText}"/>
                  <ObjectNumber number="{businessPurposeCount}"/>
                  <ObjectNumber number="{dataSubjectCount}"/>
                  <Text text="{path: 'active', formatter: '.formatter.yesNo'}"/>
                </ColumnListItem>
              </items>
            </Table>

            <Table id="entitiesTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}" class="sapUiMediumMarginTop"
              items="{path: '/LegalEntities', parameters: {$orderby: 'name', $select: 'description'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>legalEntities}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="legalEntity"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="entitiesTable"/><core:CustomData key="dialog" value="legalEntity"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="entitiesTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colLegalEntity}"/></Column>
                <Column><Text text="{i18n>colCountry}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colRegion}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colActive}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{country}"/>
                  <Text text="{region}"/>
                  <Text text="{path: 'active', formatter: '.formatter.yesNo'}"/>
                </ColumnListItem>
              </items>
            </Table>

            <Table id="rolesTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}" class="sapUiMediumMarginTop"
              items="{path: '/DataSubjectRoles', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>dataSubjectRoles}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="dataSubjectRole"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="rolesTable"/><core:CustomData key="dialog" value="dataSubjectRole"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="rolesTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colRole}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colDescription}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colActive}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{description}"/>
                  <Text text="{path: 'active', formatter: '.formatter.yesNo'}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Users (built-in login, Admin scope) ─────────────────── -->
          <IconTabFilter key="users" icon="sap-icon://employee" text="{i18n>tabUsers}"
            visible="{= %{session>/loginRequired} &amp;&amp; %{session>/isAdmin} }">
            <Table id="usersTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noData}"
              items="{path: '/Users', parameters: {$orderby: 'id', $select: 'scopes,displayName'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabUsers}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add-employee" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="user"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEditUser"/>
                  <Button text="{i18n>lock}" icon="sap-icon://locked" press=".onLockUser"><customData><core:CustomData key="locked" value="true"/></customData></Button>
                  <Button text="{i18n>unlock}" icon="sap-icon://unlocked" press=".onLockUser"><customData><core:CustomData key="locked" value="false"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="usersTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colUser}"/></Column>
                <Column><Text text="{i18n>colScopes}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colLastLogin}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{displayName}"/>
                  <Text text="{scopesText}"/>
                  <ObjectStatus text="{= %{locked} ? ${i18n>locked} : %{temporarilyLocked} ? ${i18n>temporarilyLocked} : ${i18n>active} }"
                    state="{= %{locked} || %{temporarilyLocked} ? 'Error' : 'Success' }"
                    icon="{= %{locked} || %{temporarilyLocked} ? 'sap-icon://locked' : 'sap-icon://employee' }"/>
                  <Text text="{path: 'lastLoginAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'short'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
