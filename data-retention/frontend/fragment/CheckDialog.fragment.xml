<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>checkEndOfPurpose}" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colGroup}"/>
      <ComboBox selectedKey="{view>/form/check/applicationGroupId}" showClearIcon="true" placeholder="{i18n>allGroups}"
        items="{path: '/ApplicationGroups', parameters: {$orderby: 'name', $select: 'id,name'}, templateShareable: false}">
        <core:Item key="{id}" text="{name} ({id})"/>
      </ComboBox>
      <Label text="{i18n>simulateOnly}"/>
      <CheckBox selected="{view>/form/check/simulate}"/>
    </form:SimpleForm>
    <MessageStrip text="{i18n>checkHint}" type="Information" showIcon="true" class="sapUiSmallMargin"/>
    <beginButton><Button text="{i18n>run}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
