<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{= %{view>/form/residenceRule/edit} ? ${i18n>editResidence} : ${i18n>createResidence} }" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colGround}" required="true"/>
      <ComboBox selectedKey="{view>/form/residenceRule/legalGroundId}" enabled="{= !%{view>/form/residenceRule/edit} }"
        items="{path: '/LegalGrounds', parameters: {$orderby: 'name', $select: 'id,name,businessPurposeId'}, templateShareable: false}">
        <core:Item key="{id}" text="{name} ({businessPurposeId})"/>
      </ComboBox>
      <Label text="{i18n>colDuration}" required="true"/>
      <StepInput value="{view>/form/residenceRule/duration}" min="0" max="150"/>
      <Label text="{i18n>colUnit}"/>
      <Select selectedKey="{view>/form/residenceRule/periodUnit}" forceSelection="false">
        <core:Item key="days" text="{i18n>unitDays}"/>
        <core:Item key="weeks" text="{i18n>unitWeeks}"/>
        <core:Item key="months" text="{i18n>unitMonths}"/>
        <core:Item key="years" text="{i18n>unitYears}"/>
      </Select>
      <Label text="{i18n>colActive}"/>
      <CheckBox selected="{view>/form/residenceRule/active}"/>
    </form:SimpleForm>
    <MessageStrip text="{i18n>residenceHint}" type="Information" showIcon="true" class="sapUiSmallMargin"/>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
