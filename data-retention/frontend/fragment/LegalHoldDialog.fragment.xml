<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>legalHold}" contentWidth="28rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colSubject}"/>
      <Input value="{view>/form/legalHold/id}" enabled="false"/>
      <Label text="{i18n>legalHold}"/>
      <Switch state="{view>/form/legalHold/legalHold}" customTextOn=" " customTextOff=" "/>
      <Label text="{i18n>colReason}"/>
      <TextArea value="{view>/form/legalHold/reason}" rows="3" enabled="{view>/form/legalHold/legalHold}" placeholder="LIT-2026-014"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
