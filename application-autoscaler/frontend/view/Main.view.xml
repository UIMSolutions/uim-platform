<mvc:View controllerName="uim.autoscaler.controller.Main"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
  height="100%">
  <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>appTitle}" level="H2"/></f:heading>
        <f:snappedContent><Text text="{i18n>appDescription}"/></f:snappedContent>
        <f:actions>
          <Button id="evaluateAllButton" text="{i18n>evaluateAll}" type="Emphasized" icon="sap-icon://process"
            press=".onEvaluateAll" visible="{session>/canOperate}"/>
          <Button id="seedButton" text="{i18n>seed}" icon="sap-icon://add-product" press=".onSeed"
            visible="{= %{/Statistics/bindings} === 0 &amp;&amp; %{/Statistics/policies} === 0 &amp;&amp; %{session>/canManage} }"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
          <Button id="userButton" icon="sap-icon://person-placeholder" text="{session>/displayName}" type="Transparent"
            press=".onUserMenu" visible="{session>/authenticated}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <!-- KPI header bound to the Statistics singleton -->
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox id="kpis" binding="{/Statistics}" wrap="Wrap" alignItems="Center" class="sapUiSmallMarginBottom">
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiBindings}"/>
            <ObjectNumber number="{autoscaledBindings}" unit="/ {bindings} {i18n>kpiAutoscaled}" state="Success"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiInstances}"/>
            <ObjectNumber number="{instances}" unit="{i18n>kpiRunning}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiScaleOuts}"/>
            <ObjectNumber number="{scaleOutsLast24h}" unit="· {scaleInsLast24h} {i18n>kpiScaleIns}" state="Information"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiFailed}"/>
            <ObjectNumber number="{failedLast24h}" state="{= %{failedLast24h} > 0 ? 'Error' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiPolicies}"/>
            <ObjectNumber number="{activePolicies}" unit="/ {policies} {i18n>kpiActive} · {rules} {i18n>kpiRules}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSchedules}"/>
            <ObjectNumber number="{activeSchedules}" unit="/ {schedules} {i18n>kpiNow}"
              state="{= %{activeSchedules} > 0 ? 'Information' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSamples}"/>
            <ObjectNumber number="{samplesLast24h}" unit="/ {metricSamples} {i18n>kpiToday}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSuspended}"/>
            <ObjectNumber number="{suspendedBindings}" state="{= %{suspendedBindings} > 0 ? 'Warning' : 'None' }"/>
          </VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <!-- ── Bindings ──────────────────────────────────────────────── -->
          <IconTabFilter key="bindings" icon="sap-icon://chain-link" text="{i18n>tabBindings}" count="{/Statistics/bindings}">
            <Table id="bindingsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noBindings}"
              items="{path: '/Bindings', parameters: {$orderby: 'name', $count: true}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabBindings}" level="H3"/>
                  <ToolbarSpacer/>
                  <SegmentedButton selectedKey="{view>/bindingFilter}" selectionChange=".onBindingFilter">
                    <items>
                      <SegmentedButtonItem key="" text="{i18n>all}"/>
                      <SegmentedButtonItem key="autoscaled" icon="sap-icon://resize" tooltip="{i18n>filterAutoscaled}"/>
                      <SegmentedButtonItem key="suspended" icon="sap-icon://pause" tooltip="{i18n>enum_suspended}"/>
                      <SegmentedButtonItem key="unbound" icon="sap-icon://broken-link" tooltip="{i18n>filterNoPolicy}"/>
                    </items>
                  </SegmentedButton>
                  <SearchField width="14rem" search=".onSearch" placeholder="{i18n>search}">
                    <customData><core:CustomData key="table" value="bindingsTable"/></customData>
                  </SearchField>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}">
                    <customData><core:CustomData key="dialog" value="binding"/></customData></Button>
                  <Button text="{i18n>evaluate}" icon="sap-icon://synchronize" press=".onEvaluate" visible="{session>/canOperate}">
                    <customData><core:CustomData key="table" value="bindingsTable"/></customData></Button>
                  <Button text="{i18n>scale}" icon="sap-icon://resize-horizontal" press=".onScale" visible="{session>/canOperate}">
                    <customData><core:CustomData key="table" value="bindingsTable"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="bindingsTable"/><core:CustomData key="dialog" value="binding"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="bindingsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="24%"><Text text="{i18n>colApplication}"/></Column>
                <Column><Text text="{i18n>colPolicy}"/></Column>
                <Column><Text text="{i18n>colAutoscaling}"/></Column>
                <Column width="12rem"><Text text="{i18n>colInstances}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colLimits}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastScaled}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onBindingPress">
                  <ObjectIdentifier title="{name}" text="{appGuid}"/>
                  <Link text="{= %{policyName} || ${i18n>noPolicy} }" press=".onPolicyPress" enabled="{= !!%{policyId} }"/>
                  <ObjectStatus text="{= %{status} === 'suspended' ? ${i18n>enum_suspended} : %{autoscaled} ? ${i18n>enum_active} : ${i18n>notAutoscaled} }"
                    state="{parts: [{path: 'status', targetType: 'any'}, {path: 'autoscaled', targetType: 'any'}], formatter: '.formatter.bindingState'}"/>
                  <ProgressIndicator percentValue="{= %{utilizationPercent} }" displayValue="{currentInstances} / {maxInstances}"
                    showValue="true" state="{path: 'utilizationPercent', formatter: '.formatter.utilizationState'}"
                    visible="{= %{maxInstances} > 0 }"/>
                  <ObjectStatus text="{parts: [{path: 'minInstances', targetType: 'any'}, {path: 'maxInstances', targetType: 'any'}], formatter: '.formatter.limits'}"
                    icon="{= %{limitSource} &amp;&amp; %{limitSource} !== 'policy' ? 'sap-icon://appointment-2' : '' }"
                    tooltip="{limitSource}"/>
                  <Text text="{path: 'lastScaledAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Policies ──────────────────────────────────────────────── -->
          <IconTabFilter key="policies" icon="sap-icon://action-settings" text="{i18n>tabPolicies}" count="{/Statistics/policies}">
            <Table id="policiesTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noPolicies}"
              items="{path: '/Policies', parameters: {$orderby: 'name'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabPolicies}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch" placeholder="{i18n>search}">
                    <customData><core:CustomData key="table" value="policiesTable"/></customData>
                  </SearchField>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}">
                    <customData><core:CustomData key="dialog" value="policy"/></customData></Button>
                  <Button text="{i18n>activate}" icon="sap-icon://play" press=".onOperation" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="policiesTable"/><core:CustomData key="action" value="ActivatePolicy"/>
                      <core:CustomData key="toast" value="statusChanged"/></customData></Button>
                  <Button text="{i18n>deactivate}" icon="sap-icon://pause" press=".onOperation" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="policiesTable"/><core:CustomData key="action" value="DeactivatePolicy"/>
                      <core:CustomData key="toast" value="statusChanged"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="policiesTable"/><core:CustomData key="dialog" value="policy"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}">
                    <customData><core:CustomData key="table" value="policiesTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="26%"><Text text="{i18n>colPolicy}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column><Text text="{i18n>colLimits}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colRules}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colActiveSchedule}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>colBindings}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onPolicyPress">
                  <ObjectIdentifier title="{name}" text="{description}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.policyState'}"/>
                  <Text text="{parts: [{path: 'instanceMinCount', targetType: 'any'}, {path: 'instanceMaxCount', targetType: 'any'}], formatter: '.formatter.limits'} ({timezone})"/>
                  <ObjectNumber number="{ruleCount}" unit="· {scheduleCount} {i18n>kpiSchedulesShort}"/>
                  <ObjectStatus text="{activeScheduleName}" icon="{= %{activeScheduleName} ? 'sap-icon://appointment-2' : '' }" state="Information"/>
                  <ObjectNumber number="{bindingCount}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Scaling history ───────────────────────────────────────── -->
          <IconTabFilter key="history" icon="sap-icon://history" text="{i18n>tabHistory}" count="{/Statistics/scalingEvents}">
            <Table id="eventsTable" growing="true" growingThreshold="50" noDataText="{i18n>noEvents}"
              items="{path: '/ScalingEvents', parameters: {$orderby: 'createdAt desc'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabHistory}" level="H3"/>
                  <ToolbarSpacer/>
                  <SegmentedButton selectedKey="{view>/eventFilter}" selectionChange=".onEventFilter">
                    <items>
                      <SegmentedButtonItem key="" text="{i18n>all}"/>
                      <SegmentedButtonItem key="scaleOut" icon="sap-icon://trend-up" tooltip="{i18n>enum_scaleOut}"/>
                      <SegmentedButtonItem key="scaleIn" icon="sap-icon://trend-down" tooltip="{i18n>enum_scaleIn}"/>
                      <SegmentedButtonItem key="failed" icon="sap-icon://error" tooltip="{i18n>enum_failed}"/>
                    </items>
                  </SegmentedButton>
                  <SearchField width="14rem" search=".onSearch" placeholder="{i18n>search}">
                    <customData><core:CustomData key="table" value="eventsTable"/></customData>
                  </SearchField>
                  <Button text="{i18n>purge}" icon="sap-icon://eraser" press=".onPurge" visible="{session>/canManage}"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="11rem"><Text text="{i18n>colTime}"/></Column>
                <Column><Text text="{i18n>colApplication}"/></Column>
                <Column><Text text="{i18n>colTrigger}"/></Column>
                <Column hAlign="Center"><Text text="{i18n>colInstances}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" width="35%"><Text text="{i18n>colReason}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onBindingPress">
                  <Text text="{path: 'createdAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                  <ObjectIdentifier title="{bindingName}" text="{policyName}"/>
                  <ObjectStatus text="{path: 'trigger', formatter: '.formatter.enumText'}" icon="{path: 'trigger', formatter: '.formatter.triggerIcon'}"/>
                  <ObjectStatus text="{parts: ['oldInstances', 'newInstances'], formatter: '.formatter.instanceChange'}"
                    icon="{path: 'direction', formatter: '.formatter.directionIcon'}" state="{path: 'direction', formatter: '.formatter.directionState'}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"/>
                  <Text text="{reason}{= %{message} ? ' — ' + %{message} : '' }" maxLines="2"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Metrics ───────────────────────────────────────────────── -->
          <IconTabFilter key="metrics" icon="sap-icon://line-chart" text="{i18n>tabMetrics}" count="{/Statistics/metricSamples}">
            <Table id="samplesTable" growing="true" growingThreshold="100" noDataText="{i18n>noSamples}"
              items="{path: '/MetricSamples', parameters: {$orderby: 'measuredAt desc'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabMetrics}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch" placeholder="{i18n>search}">
                    <customData><core:CustomData key="table" value="samplesTable"/></customData>
                  </SearchField>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="11rem"><Text text="{i18n>colTime}"/></Column>
                <Column><Text text="{i18n>colApplication}"/></Column>
                <Column><Text text="{i18n>colMetric}"/></Column>
                <Column hAlign="End"><Text text="{i18n>colValue}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSource}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onBindingPress">
                  <Text text="{path: 'measuredAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                  <Text text="{bindingName}"/>
                  <HBox alignItems="Center">
                    <core:Icon src="{path: 'metricName', formatter: '.formatter.metricIcon'}" class="sapUiTinyMarginEnd"/>
                    <Text text="{metricName}"/>
                  </HBox>
                  <ObjectNumber number="{path: 'value', formatter: '.formatter.number'}" unit="{unit}"/>
                  <Text text="{source}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Users (built-in login, administrators) ─────────────────── -->
          <IconTabFilter key="users" icon="sap-icon://group" text="{i18n>tabUsers}"
            visible="{= %{session>/isAdmin} &amp;&amp; %{session>/loginRequired} }">
            <Table id="usersTable" mode="SingleSelectLeft" noDataText="{i18n>noUsers}"
              items="{path: '/Users', parameters: {$orderby: 'id'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabUsers}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add-employee" press=".onOpenDialog">
                    <customData><core:CustomData key="dialog" value="user"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEditUser"/>
                  <Button text="{i18n>lock}" icon="sap-icon://locked" press=".onLockUser">
                    <customData><core:CustomData key="locked" value="true"/></customData></Button>
                  <Button text="{i18n>unlock}" icon="sap-icon://unlocked" press=".onLockUser">
                    <customData><core:CustomData key="locked" value="false"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete">
                    <customData><core:CustomData key="table" value="usersTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colUser}"/></Column>
                <Column><Text text="{i18n>colScopes}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colLastLogin}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{displayName}"/>
                  <Text text="{scopesText}"/>
                  <ObjectStatus text="{= %{locked} ? ${i18n>locked} : %{temporarilyLocked} ? ${i18n>temporarilyLocked} : ${i18n>enum_active} }"
                    state="{= %{locked} || %{temporarilyLocked} ? 'Error' : 'Success' }"/>
                  <Text text="{path: 'lastLoginAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
