<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>attachPolicy}" contentWidth="30rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colApplication}"/>
      <Text text="{view>/form/attach/name}"/>
      <Label text="{i18n>colPolicy}" required="true"/>
      <Select selectedKey="{view>/form/attach/policyId}" forceSelection="false"
        items="{path: '/Policies', parameters: {$orderby: 'name'}, templateShareable: false}">
        <core:Item key="{id}" text="{name} ({instanceMinCount} … {instanceMaxCount})"/>
      </Select>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>attach}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
