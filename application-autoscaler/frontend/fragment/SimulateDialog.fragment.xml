<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>simulateTitle}" contentWidth="32rem">
    <MessageStrip text="{i18n>simulateHint}" showIcon="true" class="sapUiSmallMargin"/>
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colApplication}"/>
      <Text text="{view>/form/simulate/name}"/>
      <Label text="{i18n>colMetric}" required="true"/>
      <ComboBox value="{view>/form/simulate/metricName}">
          <core:Item key="cpu" text="cpu (%)"/>
          <core:Item key="cpuutil" text="cpuutil (%)"/>
          <core:Item key="memoryused" text="memoryused (MB)"/>
          <core:Item key="memoryutil" text="memoryutil (%)"/>
          <core:Item key="disk" text="disk (MB)"/>
          <core:Item key="diskutil" text="diskutil (%)"/>
          <core:Item key="throughput" text="throughput (rps)"/>
          <core:Item key="responsetime" text="responsetime (ms)"/>
      </ComboBox>
      <Label text="{i18n>colValue}" required="true"/>
      <StepInput value="{view>/form/simulate/value}" min="0" max="100000000" displayValuePrecision="1"/>
      <Label text="{i18n>colDuration}"/>
      <StepInput value="{view>/form/simulate/durationSeconds}" min="0" max="3600" step="30" description="s"/>
      <Label text="{i18n>colStep}"/>
      <StepInput value="{view>/form/simulate/stepSeconds}" min="5" max="600" step="5" description="s"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>simulate}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
