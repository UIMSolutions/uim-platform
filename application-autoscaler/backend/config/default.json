{
  "serviceName": "uim-application-autoscaler",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8097,
  "storage": "file",
  "dataFile": "data/application-autoscaler.json",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "odataPath": "/odata/v4/autoscaler",
  "maxPageSize": 500,
  "maxRequestBytes": 1048576,
  "authMode": "jwt",
  "jwtSecret": "",
  "tokenTtlSeconds": 3600,
  "adminUser": "admin",
  "adminPassword": "",
  "passwordIterations": 120000,
  "maxFailedLogins": 5,
  "lockSeconds": 900,
  "minPasswordLength": 10,
  "metricStaleSeconds": 600,
  "metricRetentionHours": 48,
  "eventRetentionDays": 30,
  "recordIgnored": false,
  "frontendDir": "../frontend",
  "evaluationIntervalSeconds": 30,
  "purgeEveryRuns": 20,
  "workerTenants": ["default"],
  "instanceMode": "simulate",
  "instanceUrl": "",
  "instanceTimeoutSeconds": 30
}
