<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="manifestDialog" title="{i18n>manifest}" contentWidth="44rem" contentHeight="32rem" resizable="true">
    <content>
      <TextArea value="{ui>/manifest}" editable="false" width="100%" rows="28" class="sapUiSmallMargin"/>
    </content>
    <endButton>
      <Button text="{i18n>close}" press=".onCloseManifest"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
