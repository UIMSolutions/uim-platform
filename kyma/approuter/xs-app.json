{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/odata/v4/kyma/(.*)$",
      "target": "/odata/v4/kyma/$1",
      "destination": "kyma-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.KymaViewer", "$XSAPPNAME.KymaDeveloper", "$XSAPPNAME.KymaAdmin"],
        "default": ["$XSAPPNAME.KymaDeveloper", "$XSAPPNAME.KymaAdmin"]
      }
    },
    {
      "source": "^/api/v1/(.*)$",
      "target": "/api/v1/$1",
      "destination": "kyma-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.KymaViewer", "$XSAPPNAME.KymaDeveloper", "$XSAPPNAME.KymaAdmin"],
        "default": ["$XSAPPNAME.KymaDeveloper", "$XSAPPNAME.KymaAdmin"]
      }
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.KymaViewer", "$XSAPPNAME.KymaDeveloper", "$XSAPPNAME.KymaAdmin"]
    }
  ]
}
