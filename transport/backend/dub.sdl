name "transport"
description "SAP Cloud Transport Management style service — D/vibe.d backend with REST, OData v4, CLI and GtkD GUI"
homepage "https://github.com/UIMSolutions/uim/platform/transport"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

targetPath "build"
sourcePaths "source"
importPaths "source"

// Core framework (brings uim-framework, vibe-d 0.10.x and gtk-d)
dependency "uim-platform:service" path="../.."

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"

// ── HTTP server: REST (/api/v1/transport) + OData v4 (/odata/v4/transport) ──
// dub build            (or --config=defaultRun)
// ./build/uim-transport-platform-service
configuration "defaultRun" {
	targetType "executable"
	targetName "uim-transport-platform-service"
	mainSourceFile "source/app.d"
	excludedSourceFiles "source/cli.d" "source/gui.d"
}

// ── Command line interface ──────────────────────────────────────────────────
// dub build --config=cli
// ./build/uim-transport-cli help
configuration "cli" {
	targetType "executable"
	targetName "uim-transport-cli"
	mainSourceFile "source/cli.d"
	excludedSourceFiles "source/app.d" "source/gui.d"
}

// ── Desktop GUI (GtkD 3 / GTK 3.24) ─────────────────────────────────────────
// dub build --config=gui
// ./build/uim-transport-gui [--tenant=<id>] [--data-dir=<dir>]
configuration "gui" {
	targetType "executable"
	targetName "uim-transport-gui"
	mainSourceFile "source/gui.d"
	excludedSourceFiles "source/app.d" "source/cli.d"
	dependency "gtk-d" version="~>3.11.0"
}

// ── Libraries / unit tests ──────────────────────────────────────────────────
configuration "defaultTest" {
	targetType "library"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "inits" {
	targetType "library"
	versions "show_module" "show_init"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "calls" {
	targetType "library"
	versions "show_module" "show_test" "show_function"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "verbose" {
	targetType "library"
	versions "show_module" "show_test" "show_init" "show_function"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}
