{
  "xsappname": "uim-event-mesh",
  "tenant-mode": "dedicated",
  "description": "UIM Event Mesh — messaging services, queues, subscriptions, webhooks and clients",
  "scopes": [
    { "name": "$XSAPPNAME.Read", "description": "Read all event mesh resources and messages" },
    { "name": "$XSAPPNAME.Manage", "description": "Maintain services, clients, queues, subscriptions, webhooks, channels and bindings" },
    { "name": "$XSAPPNAME.Publish", "description": "Publish events to topics" },
    { "name": "$XSAPPNAME.Consume", "description": "Consume and acknowledge queue messages" }
  ],
  "role-templates": [
    { "name": "Viewer", "description": "Read only", "scope-references": ["$XSAPPNAME.Read"] },
    { "name": "Integrator", "description": "Publish and consume events",
      "scope-references": ["$XSAPPNAME.Read", "$XSAPPNAME.Publish", "$XSAPPNAME.Consume"] },
    { "name": "Administrator", "description": "Operate the event mesh",
      "scope-references": ["$XSAPPNAME.Read", "$XSAPPNAME.Manage", "$XSAPPNAME.Publish", "$XSAPPNAME.Consume"] }
  ],
  "role-collections": [
    { "name": "EventMeshViewer", "role-template-references": ["$XSAPPNAME.Viewer"] },
    { "name": "EventMeshIntegrator", "role-template-references": ["$XSAPPNAME.Integrator"] },
    { "name": "EventMeshAdministrator", "role-template-references": ["$XSAPPNAME.Administrator"] }
  ],
  "oauth2-configuration": { "redirect-uris": ["https://*.hana.ondemand.com/**", "http://localhost:5000/**"] }
}
