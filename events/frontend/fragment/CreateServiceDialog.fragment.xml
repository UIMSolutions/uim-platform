<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createService}" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/service/name}"/>
      <Label text="{i18n>colNamespace}" required="true"/>
      <Input value="{view>/form/service/namespace}" placeholder="acme/sales/orders"/>
      <Label text="{i18n>colPlan}"/>
      <Select selectedKey="{view>/form/service/plan}">
        <core:Item key="dev" text="Dev"/>
        <core:Item key="standard" text="Standard"/>
        <core:Item key="premium" text="Premium"/>
      </Select>
      <Label text="{i18n>colRegion}"/>
      <Input value="{view>/form/service/region}" placeholder="eu10"/>
      <Label text="{i18n>colDescription}"/>
      <Input value="{view>/form/service/description}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
