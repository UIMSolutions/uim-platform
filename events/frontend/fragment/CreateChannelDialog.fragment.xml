<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createChannel}" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
      <Label text="{i18n>colService}" required="true"/>
      <Select selectedKey="{view>/form/channel/serviceId}" forceSelection="false" items="{path: '/MessagingServices', parameters: {$orderby: 'name'}}"><core:Item key="{id}" text="{name} ({namespace})"/></Select>
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/channel/name}"/>
      <Label text="{i18n>colTopic}" required="true"/>
      <Input value="{view>/form/channel/topicName}" placeholder="acme/sales/orders/ce/created"/>
      <Label text="{i18n>colType}"/>
      <Select selectedKey="{view>/form/channel/channelType}">
        <core:Item key="topic" text="{i18n>typeTopic}"/>
        <core:Item key="queue" text="{i18n>typeQueue}"/>
      </Select>
      <Label text="{i18n>colDescription}"/>
      <Input value="{view>/form/channel/description}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
