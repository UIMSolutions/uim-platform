extends layout

block content
  nav(aria-label="breadcrumb")
    ul
      li
        a(href="/web") Home
      li Architecture

  h1 Architektur Bausteine
  button(type="button", onclick="window.location.href='/web/architecture/create'") Create

  div(class="overflow-auto")
    table(class="striped")
      thead
        tr
          th(scope="col") Name
          th(scope="col") Version
          th(scope="col") Title
          th(scope="col") Responsible

      tbody
        - foreach (block; blocks)
          tr
            td
              a(href="/web/architecture/view/"~block.id.value)=block.id
            td= block.versionLabel
            td= block.title
            td= block.owner

