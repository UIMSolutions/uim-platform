# Build context: the uim-platform repository root (the backend depends on
# the shared "service" package via a path dependency):
#   podman build -f architecture/backend/Dockerfile -t uim-platform/architecture .
FROM dlang2/ldc-ubuntu:1.40.1 AS build
WORKDIR /build
COPY . .
WORKDIR /build/architecture/backend
RUN dub build --build=release --config=defaultRun --compiler=ldc2 \
 && dub build --build=release --config=cli --compiler=ldc2

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false appuser && mkdir -p /data && chown appuser:appuser /data
WORKDIR /app
COPY --from=build /build/architecture/backend/build/uim-architecture-platform-service /build/architecture/backend/build/uim-architecture-cli ./
COPY --from=build /build/architecture/backend/config ./config
COPY --from=build /build/architecture/frontend ./frontend
USER appuser

EXPOSE 8122
ENV ARCHITECTURE_HOST=0.0.0.0 \
    ARCHITECTURE_PORT=8122 \
    ARCHITECTURE_STORAGE=file \
    ARCHITECTURE_DATA_FILE=/data/architecture.json \
    ARCHITECTURE_FRONTEND_DIR=/app/frontend \
    ARCHITECTURE_SEED_DEMO_DATA=false
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8122/health || exit 1

CMD ["./uim-architecture-platform-service"]
