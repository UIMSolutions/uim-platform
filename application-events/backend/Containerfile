# Podman/Buildah: identical to the Dockerfile.
# Build context: the uim-platform repository root (the backend depends on
# the shared "service" package via a path dependency):
#   podman build -f application-events/backend/Containerfile -t uim-platform/application-events .
FROM dlang2/ldc-ubuntu:1.40.1 AS build
WORKDIR /build
COPY . .
WORKDIR /build/application-events/backend
RUN dub build --build=release --config=defaultRun --compiler=ldc2 \
 && dub build --build=release --config=cli --compiler=ldc2

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libgcc-s1 tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false appuser && mkdir -p /data && chown appuser:appuser /data
WORKDIR /app
COPY --from=build /build/application-events/backend/build/uim-application-events-platform-service /build/application-events/backend/build/uim-application-events-cli ./
COPY --from=build /build/application-events/backend/config ./config
COPY --from=build /build/application-events/frontend ./frontend
USER appuser

EXPOSE 8132
# Built-in login: set APPEVENTS_JWT_SECRET (>= 32 characters) and APPEVENTS_ADMIN_PASSWORD,
# e.g. from a Kubernetes secret (see k8s/secret.example.yaml).
ENV APPEVENTS_HOST=0.0.0.0 \
    APPEVENTS_PORT=8132 \
    APPEVENTS_STORAGE=file \
    APPEVENTS_DATA_FILE=/data/application-events.json \
    APPEVENTS_FRONTEND_DIR=/app/frontend \
    APPEVENTS_AUTH_MODE=jwt
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8132/health || exit 1

CMD ["./uim-application-events-platform-service"]
