{
  "serviceName": "uim-application-events",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8132,
  "storage": "file",
  "dataFile": "data/application-events.json",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "odataPath": "/odata/v4/appevents",
  "maxPageSize": 500,
  "maxRequestBytes": 4194304,
  "authMode": "jwt",
  "jwtSecret": "",
  "tokenTtlSeconds": 3600,
  "adminUser": "admin",
  "adminPassword": "",
  "passwordIterations": 120000,
  "maxFailedLogins": 5,
  "lockSeconds": 900,
  "minPasswordLength": 10,
  "requireRegisteredTopics": true,
  "deliverOnPublish": true,
  "maxPayloadBytes": 1048576,
  "maxBatchEvents": 100,
  "maxBackoffSeconds": 3600,
  "messageRetentionHours": 72,
  "deadLetterRetentionDays": 30,
  "maxDispatchBatch": 500,
  "frontendDir": "../frontend",
  "dispatchIntervalSeconds": 10,
  "purgeEveryRuns": 360,
  "workerTenants": ["default"],
  "deliveryMode": "simulate",
  "deliveryTimeoutSeconds": 10
}
