<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>assignTitle}" contentWidth="30rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colFormation}"/>
      <Text text="{view>/form/assign/name}"/>
      <Label text="{i18n>colSystem}" required="true"/>
      <Select selectedKey="{view>/form/assign/systemId}" forceSelection="false" showSecondaryValues="true"
        items="{path: '/Systems', parameters: {$orderby: 'name'}, templateShareable: false}">
        <core:ListItem key="{id}" text="{name}" additionalText="{formationName}"/>
      </Select>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>assign}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
