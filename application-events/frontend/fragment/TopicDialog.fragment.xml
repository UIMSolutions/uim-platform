<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{= %{view>/form/topic/edit} ? ${i18n>editTopic} : ${i18n>createTopic} }" contentWidth="40rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3" labelSpanL="3">
      <Label text="{i18n>colEventType}" required="true"/>
      <Input value="{view>/form/topic/eventType}" enabled="{= !%{view>/form/topic/edit} }"
        placeholder="sap.s4.beh.businesspartner.v1.BusinessPartner.Created.v1"/>
      <Label text="{i18n>colTitle}"/>
      <Input value="{view>/form/topic/title}"/>
      <Label text="{i18n>colCategory}"/>
      <Input value="{view>/form/topic/category}"/>
      <Label text="{i18n>colVersion}"/>
      <Input value="{view>/form/topic/version}" width="8rem"/>
      <Label text="{i18n>colOwner}"/>
      <Select selectedKey="{view>/form/topic/ownerSystemId}" forceSelection="false"
        items="{path: '/Systems', parameters: {$orderby: 'name', $filter: 'systemType ne \'consumer\''}, templateShareable: false}">
        <core:Item key="{id}" text="{name}"/>
      </Select>
      <Label text="{i18n>colDescription}"/>
      <TextArea value="{view>/form/topic/description}" rows="3"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>save}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
