# Build context: the uim-platform repository root (the backend depends on
# uim-platform:service via a path dependency):
#   podman build -f task-center/backend/Containerfile -t uim-platform/task-center .
FROM dlang2/ldc-ubuntu:1.40.1 AS build
WORKDIR /build
COPY . .
WORKDIR /build/task-center/backend
RUN dub build --build=release --config=defaultRun --compiler=ldc2 \
 && dub build --build=release --config=cli --compiler=ldc2

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false appuser && mkdir -p /data && chown appuser:appuser /data
WORKDIR /app
COPY --from=build /build/task-center/backend/build/uim-task-center-platform-service /build/task-center/backend/build/uim-task-center-cli ./
COPY --from=build /build/task-center/backend/config ./config
COPY --from=build /build/task-center/frontend ./frontend
USER appuser

EXPOSE 8103
ENV TASK_CENTER_HOST=0.0.0.0 \
    TASK_CENTER_PORT=8103 \
    TASK_CENTER_STORAGE=file \
    TASK_CENTER_DATA_FILE=/data/task-center.json \
    TASK_CENTER_FRONTEND_DIR=/app/frontend
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8103/health || exit 1

CMD ["./uim-task-center-platform-service"]
