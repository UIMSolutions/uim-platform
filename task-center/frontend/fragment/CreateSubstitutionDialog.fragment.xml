<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createSubstitution}" contentWidth="32rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
      <Label text="{i18n>colUser}"/>
      <Input value="{view>/form/substitution/userId}"/>
      <Label text="{i18n>colSubstitute}" required="true"/>
      <Input value="{view>/form/substitution/substituteId}"/>
      <Label text="{i18n>colDefinition}"/>
      <Select selectedKey="{view>/form/substitution/definitionId}" forceSelection="false"
        items="{path: '/TaskDefinitions', parameters: {$orderby: 'name'}}"><core:Item key="{id}" text="{name}"/></Select>
      <Label text="{i18n>colStart}"/>
      <DatePicker value="{view>/form/substitution/startDate}" valueFormat="yyyy-MM-dd"/>
      <Label text="{i18n>colEnd}"/>
      <DatePicker value="{view>/form/substitution/endDate}" valueFormat="yyyy-MM-dd"/>
      <Label text="{i18n>colAutoForward}"/>
      <Switch state="{view>/form/substitution/isAutoForward}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
