name "authorization"
description "SAP BTP-style Authorization Management Service using D, vibe.d, Clean and Hexagonal architecture"
homepage "https://github.com/UIMSolutions/uim-platform/authorization"
authors "Ozan Nurettin Suel" "UI Manufaktur (R.I.P)"
copyright "Copyright 2018-2026, Ozan Nurettin Suel"
license "Apache-2.0"

targetType "executable"
targetName "uim-authorization-platform-service"
targetPath "build"
sourcePaths "source"
importPaths "source"

dependency "uim-platform:service" path=".."
dependency "vibe-d" version="~>0.10.3"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"

configuration "defaultRun" {
  targetType "executable"
}
configuration "defaultTest" {
  targetType "library"
  excludedSourceFiles "source/app.d"
}
configuration "modules" {
  targetType "library"
  versions "show_module"
}
configuration "tests" {
  targetType "library"
  versions "show_module" "show_test"
}
configuration "inits" {
  targetType "library"
  versions "show_module" "show_init"
}
configuration "calls" {
  targetType "library"
  versions "show_module" "show_test" "show_function"
}
configuration "verbose" {
  targetType "library"
  versions "show_module" "show_test" "show_init" "show_function"
}
