{
  "serviceName": "uim-authorization",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8117,
  "logLevel": "info",
  "storage": "file",
  "dataFile": "data/authorization.json",
  "mongoUri": "mongodb://localhost:27017",
  "mongoDb": "uim_authorization",
  "mongoCollection": "documents",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "restPath": "/rest/v1/authorization",
  "odataPath": "/odata/v4/authorization",
  "webPath": "/web",
  "maxPageSize": 200,
  "requireAuthentication": false,
  "jwtSecret": "",
  "frontendDir": "../frontend",
  "recordDecisions": true,
  "decisionRetentionDays": 90,
  "decisionPruneMinutes": 0,
  "workerTenants": ["default"],
  "seedBasePolicies": true,
  "seedTenantId": "default",
  "seedAppName": "authorization-management",
  "seedOrganizationId": "global",
  "seedDemoData": true
}
