<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog id="dlgCreateApplicationDialog" title="{i18n>titleCreateApplication}" contentWidth="36rem" draggable="true" resizable="true">
    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4" columnsM="1" columnsL="1">
      <Label text="{i18n>name}" required="true"/>
      <Input value="{ui>/draft/name}" placeholder="incident-management"/>
      <Label text="{i18n>organization}"/>
      <Input value="{ui>/draft/organizationId}"/>
      <Label text="{i18n>description}"/>
      <TextArea value="{ui>/draft/description}" rows="2"/>
    </f:SimpleForm>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press=".onCreateSave"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCreateCancel"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
