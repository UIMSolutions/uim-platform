{
  "serviceName": "Identity Authentication Service",
  "host": "0.0.0.0",
  "port": 8125,
  "logLevel": "info",
  "storage": "file",
  "dataDir": "data",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "restPath": "/rest/v1/identity-authentication",
  "odataPath": "/odata/v4/identity-authentication",
  "frontendDir": "../frontend",
  "issuer": "uim-identity-authentication",
  "sessionTimeoutMinutes": 480,
  "accessTokenMinutes": 60,
  "idTokenMinutes": 60,
  "refreshTokenHours": 24,
  "maxFailedLogins": 5,
  "passwordIterations": 60000,
  "passwordMinLength": 8,
  "otpWebhookUrl": "",
  "cleanupIntervalMinutes": 30,
  "cleanupTenants": ["default"]
}
