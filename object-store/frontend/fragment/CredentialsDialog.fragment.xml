<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog id="credentialsDialog" title="{i18n>credentialsTitle}" contentWidth="40rem" type="Message" state="Warning">
    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip text="{i18n>credentialsOnce}" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
        <f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4">
          <Label text="{i18n>colBucket}"/>
          <Text text="{ui>/credentials/bucketName}"/>
          <Label text="{i18n>endpoint}"/>
          <Text text="{ui>/credentials/endpoint}" wrapping="true"/>
          <Label text="{i18n>colAccessKey}"/>
          <Text text="{ui>/credentials/accessKeyId}" class="sapUiTinyMarginTop"/>
          <Label text="{i18n>secretAccessKey}"/>
          <Text text="{ui>/credentials/secretAccessKey}" class="sapUiTinyMarginTop"/>
        </f:SimpleForm>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>copy}" icon="sap-icon://copy" press=".onCopyCredentials"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>close}" type="Emphasized" press=".onCloseCredentials"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
