<mvc:View
  controllerName="uim.objectstore.controller.BucketDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:uxap="sap.uxap"
  xmlns:u="sap.ui.unified"
  xmlns:l="sap.ui.layout"
  xmlns="sap.m">
  <uxap:ObjectPageLayout id="bucketPage" showTitleInHeaderContent="true" upperCaseAnchorBar="false" busy="{ui>/busy}">
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:navigationActions>
          <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>close}" press=".onNavBack"/>
        </uxap:navigationActions>
        <uxap:heading>
          <Title text="{name}" wrapping="true"/>
        </uxap:heading>
        <uxap:snappedContent>
          <Text text="{path: 'provider', formatter: '.formatter.enumText'} · {region}"/>
        </uxap:snappedContent>
        <uxap:expandedContent>
          <Text text="{description}"/>
        </uxap:expandedContent>
        <uxap:actions>
          <Button text="{i18n>suspend}" visible="{= %{status} === 'active' }" press=".onBucketAction('SuspendBucket')"/>
          <Button text="{i18n>resume}" visible="{= %{status} === 'suspended' }" press=".onBucketAction('ResumeBucket')"/>
          <Button text="{i18n>applyLifecycle}" icon="sap-icon://history" press=".onApplyLifecycle"/>
          <Button text="{i18n>empty}" icon="sap-icon://clear-all" press=".onEmpty"/>
        </uxap:actions>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:headerContent>
      <l:VerticalLayout class="sapUiMediumMarginEnd">
        <ObjectStatus title="{i18n>colStatus}" text="{path: 'status', formatter: '.formatter.enumText'}"
          state="{path: 'status', formatter: '.formatter.statusState'}" icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
        <ObjectStatus title="{i18n>fldVersioning}" text="{= ${versioningEnabled} ? ${i18n>on} : ${i18n>off} }"/>
        <ObjectStatus title="{i18n>fldPublicAccessBlocked}" text="{= ${publicAccessBlocked} ? ${i18n>yes} : ${i18n>no} }"
          state="{= ${publicAccessBlocked} ? 'Success' : 'Warning' }"/>
      </l:VerticalLayout>
      <l:VerticalLayout class="sapUiMediumMarginEnd">
        <ObjectStatus title="{i18n>colStorageClass}" text="{path: 'storageClass', formatter: '.formatter.enumText'}"/>
        <ObjectStatus title="{i18n>colEncryption}" text="{path: 'encryptionType', formatter: '.formatter.enumText'}"/>
        <ObjectStatus title="{i18n>fldEncryptionKeyId}" text="{encryptionKeyId}" visible="{= !!${encryptionKeyId} }"/>
      </l:VerticalLayout>
      <l:VerticalLayout class="sapUiMediumMarginEnd" width="16rem">
        <Label text="{i18n>colUsage}"/>
        <ProgressIndicator
          percentValue="{parts: [{path: 'usedBytes', targetType: 'any'}, {path: 'quotaBytes', targetType: 'any'}], formatter: '.formatter.usagePercent'}"
          displayValue="{path: 'usedBytes', targetType: 'any', formatter: '.formatter.bytes'} / {path: 'quotaBytes', targetType: 'any', formatter: '.formatter.quota'}"
          state="{parts: [{path: 'usedBytes', targetType: 'any'}, {path: 'quotaBytes', targetType: 'any'}], formatter: '.formatter.usageState'}" showValue="true"/>
        <ObjectStatus title="{i18n>colObjects}" text="{objectCount} · {i18n>kpiVersions}: {versionCount}"/>
      </l:VerticalLayout>
      <l:VerticalLayout>
        <ObjectStatus title="{i18n>fldLabels}" text="{path: 'labels', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
        <ObjectStatus title="{i18n>colCreated}" text="{path: 'createdAt', formatter: '.formatter.dateTime'}"/>
      </l:VerticalLayout>
    </uxap:headerContent>

    <uxap:sections>
      <!-- ── Objects (folder browser over the REST listing) ── -->
      <uxap:ObjectPageSection id="objectsSection" title="{i18n>secObjects}" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <VBox>
              <Breadcrumbs id="crumbs" currentLocationText="{= ${ui>/browser/prefix} ? '' : ${name} }"
                links="{path: 'ui>/browser/crumbs', templateShareable: false}">
                <Link text="{ui>text}" press=".onCrumb"/>
              </Breadcrumbs>
              <Table id="browserTable" mode="SingleSelectLeft" items="{ui>/browser/rows}" noDataText="{i18n>noObjects}"
                sticky="ColumnHeaders,HeaderToolbar" growing="true" growingThreshold="100">
                <headerToolbar>
                  <OverflowToolbar>
                    <Title text="{= ${ui>/browser/prefix} || '/' }" level="H3"/>
                    <ToolbarSpacer/>
                    <Button icon="sap-icon://navigation-up-arrow" tooltip="{i18n>up}" press=".onUp" enabled="{= !!${ui>/browser/prefix} }"/>
                    <u:FileUploader id="uploader" buttonOnly="true" buttonText="{i18n>upload}" icon="sap-icon://upload"
                      sameFilenameAllowed="true" change=".onUpload" multiple="false"/>
                    <Button text="{i18n>newTextObject}" icon="sap-icon://add-document" press=".onNewObject"/>
                    <Button text="{i18n>download}" icon="sap-icon://download" press=".onDownload"/>
                    <Button text="{i18n>versions}" icon="sap-icon://history" press=".onVersions"/>
                    <Button text="{i18n>copy}" icon="sap-icon://copy" press=".onObjectAction('CopyStorageObject', 'targetBucketId,targetKey')"/>
                    <Button text="{i18n>archive}" press=".onObjectAction('ArchiveStorageObject', '')"/>
                    <Button text="{i18n>restore}" press=".onObjectAction('RestoreStorageObject', '')"/>
                    <Button text="{i18n>hold}" icon="sap-icon://locked" press=".onObjectAction('HoldStorageObject', '')"/>
                    <Button text="{i18n>release}" icon="sap-icon://unlocked" press=".onObjectAction('ReleaseStorageObject', '')"/>
                    <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDeleteObject"/>
                  </OverflowToolbar>
                </headerToolbar>
                <columns>
                  <Column><Text text="{i18n>colKey}"/></Column>
                  <Column width="8rem" hAlign="End"><Text text="{i18n>colSize}"/></Column>
                  <Column width="10rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colContentType}"/></Column>
                  <Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colStorageClass}"/></Column>
                  <Column width="5rem" minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>colVersion}"/></Column>
                  <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colModified}"/></Column>
                  <Column width="8rem"><Text text="{i18n>colStatus}"/></Column>
                </columns>
                <items>
                  <ColumnListItem type="{= ${ui>folder} ? 'Navigation' : 'Inactive' }" press=".onOpenFolder">
                    <cells>
                      <HBox alignItems="Center">
                        <core:Icon src="{parts: ['ui>contentType', 'ui>folder'], formatter: '.formatter.fileIcon'}" class="sapUiTinyMarginEnd"/>
                        <Text text="{path: 'ui>name', formatter: '.formatter.leafName'}"/>
                      </HBox>
                      <Text text="{= ${ui>folder} ? '' : ${path: 'ui>size', formatter: '.formatter.bytes'} }"/>
                      <Text text="{ui>contentType}"/>
                      <Text text="{path: 'ui>storageClass', formatter: '.formatter.enumText'}"/>
                      <Text text="{ui>currentVersion}"/>
                      <Text text="{path: 'ui>updatedAt', formatter: '.formatter.dateTime'}"/>
                      <HBox>
                        <ObjectStatus text="{path: 'ui>status', formatter: '.formatter.enumText'}" state="{path: 'ui>status', formatter: '.formatter.statusState'}"/>
                        <core:Icon src="sap-icon://locked" visible="{= !!${ui>legalHold} }" tooltip="{i18n>kpiLegalHold}" class="sapUiTinyMarginBegin"/>
                      </HBox>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <!-- ── Access policies ── -->
      <uxap:ObjectPageSection title="{i18n>secPolicies}" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <Table id="policyTable" mode="SingleSelectLeft" noDataText="{i18n>noPolicies}"
              items="{path: '/AccessPolicies', parameters: {$orderby: 'name', $select: 'principals,actions,resources'}, suspended: true}">
              <headerToolbar>
                <OverflowToolbar>
                  <Text text="{i18n>policiesInfo}"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreateChild('AccessPolicies')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('policyTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="6rem"><Text text="{i18n>fldEffect}"/></Column>
                <Column><Text text="{i18n>fldPrincipals}"/></Column>
                <Column><Text text="{i18n>fldActions}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>fldResources}"/></Column>
                <Column width="6rem"><Text text="{i18n>fldEnabled}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <ObjectStatus text="{effect}" state="{path: 'effect', formatter: '.formatter.statusState'}"/>
                    <Text text="{path: 'principals', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
                    <Text text="{path: 'actions', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
                    <Text text="{path: 'resources', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
                    <Switch state="{enabled}" customTextOn=" " customTextOff=" "/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <!-- ── Lifecycle rules ── -->
      <uxap:ObjectPageSection title="{i18n>secLifecycle}" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <Table id="lifecycleTable" mode="SingleSelectLeft" noDataText="{i18n>noRules}"
              items="{path: '/LifecycleRules', parameters: {$orderby: 'name'}, suspended: true}">
              <headerToolbar>
                <OverflowToolbar>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreateChild('LifecycleRules')"/>
                  <Button text="{i18n>applyNow}" icon="sap-icon://history" press=".onAction('lifecycleTable', 'ApplyLifecycleRule', '')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('lifecycleTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="8rem"><Text text="{i18n>fldPrefix}"/></Column>
                <Column><Text text="{i18n>colActions}"/></Column>
                <Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>lastRun}"/></Column>
                <Column width="7rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{name}"/>
                    <Text text="{= ${prefix} || '*' }"/>
                    <Text text="{parts: ['transitionDays', 'transitionStorageClass', 'expirationDays', 'noncurrentVersionExpirationDays'], formatter: '.ruleText'}"/>
                    <Text text="{path: 'lastAppliedAt', formatter: '.formatter.dateTime'}"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <!-- ── CORS rules ── -->
      <uxap:ObjectPageSection title="{i18n>secCors}" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <Table id="corsTable" mode="SingleSelectLeft" noDataText="{i18n>noRules}"
              items="{path: '/CorsRules', parameters: {$orderby: 'name', $select: 'allowedOrigins,allowedMethods,allowedHeaders'}, suspended: true}">
              <headerToolbar>
                <OverflowToolbar>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreateChild('CorsRules')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('corsTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column><Text text="{i18n>fldOrigins}"/></Column>
                <Column><Text text="{i18n>fldMethods}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>fldAllowedHeaders}"/></Column>
                <Column width="6rem" hAlign="End"><Text text="{i18n>fldMaxAge}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{name}"/>
                    <Text text="{path: 'allowedOrigins', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
                    <Text text="{path: 'allowedMethods', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
                    <Text text="{path: 'allowedHeaders', targetType: 'any', mode: 'OneTime', formatter: '.formatter.joinList'}"/>
                    <Text text="{maxAgeSeconds} s"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <!-- ── Service bindings ── -->
      <uxap:ObjectPageSection title="{i18n>secBindings}" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <Table id="bindingTable" mode="SingleSelectLeft" noDataText="{i18n>noBindings}"
              items="{path: '/ServiceBindings', parameters: {$orderby: 'name', $select: 'secretAccessKey,bucketName'}, suspended: true}">
              <headerToolbar>
                <OverflowToolbar>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreateChild('ServiceBindings')"/>
                  <Button text="{i18n>rotate}" icon="sap-icon://synchronize" press=".onAction('bindingTable', 'RotateServiceBinding', '')"/>
                  <Button text="{i18n>revoke}" icon="sap-icon://cancel" press=".onAction('bindingTable', 'RevokeServiceBinding', '')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('bindingTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="8rem"><Text text="{i18n>colPermission}"/></Column>
                <Column width="14rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colAccessKey}"/></Column>
                <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastUsed}"/></Column>
                <Column width="7rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <Text text="{path: 'permission', formatter: '.formatter.enumText'}"/>
                    <Text text="{accessKeyId}"/>
                    <Text text="{path: 'lastUsedAt', formatter: '.formatter.dateTime'}"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>
  </uxap:ObjectPageLayout>
</mvc:View>
