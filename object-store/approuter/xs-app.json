{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/odata/v4/object-store/(.*)$",
      "target": "/odata/v4/object-store/$1",
      "destination": "object-store-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.ObjectStoreViewer", "$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"],
        "default": ["$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"]
      }
    },
    {
      "source": "^/api/v1/object-store/content/(.*)$",
      "target": "/api/v1/object-store/content/$1",
      "destination": "object-store-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.ObjectStoreViewer", "$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"],
        "HEAD": ["$XSAPPNAME.ObjectStoreViewer", "$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"],
        "default": ["$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"]
      }
    },
    {
      "source": "^/api/v1/(.*)$",
      "target": "/api/v1/$1",
      "destination": "object-store-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.ObjectStoreViewer", "$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"],
        "default": ["$XSAPPNAME.ObjectStoreAdmin"]
      }
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.ObjectStoreViewer", "$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreAdmin"]
    }
  ]
}
