{
  "xsappname": "uim-object-store",
  "tenant-mode": "dedicated",
  "description": "UIM Object Store service",
  "scopes": [
    { "name": "$XSAPPNAME.ObjectStoreViewer", "description": "Read buckets, objects, versions, policies, rules, bindings and reference data; download content" },
    { "name": "$XSAPPNAME.ObjectStoreUser", "description": "Upload, copy, archive and delete objects; manage versions" },
    { "name": "$XSAPPNAME.ObjectStoreAdmin", "description": "Manage buckets, access policies, lifecycle and CORS rules, service bindings" }
  ],
  "role-templates": [
    { "name": "ObjectStoreViewer", "description": "Object store viewer", "scope-references": ["$XSAPPNAME.ObjectStoreViewer"] },
    { "name": "ObjectStoreUser", "description": "Object store user",
      "scope-references": ["$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreViewer"] },
    { "name": "ObjectStoreAdmin", "description": "Object store administrator",
      "scope-references": ["$XSAPPNAME.ObjectStoreAdmin", "$XSAPPNAME.ObjectStoreUser", "$XSAPPNAME.ObjectStoreViewer"] }
  ],
  "role-collections": [
    { "name": "UIM Object Store Viewer", "role-template-references": ["$XSAPPNAME.ObjectStoreViewer"] },
    { "name": "UIM Object Store User", "role-template-references": ["$XSAPPNAME.ObjectStoreUser"] },
    { "name": "UIM Object Store Administrator", "role-template-references": ["$XSAPPNAME.ObjectStoreAdmin"] }
  ],
  "oauth2-configuration": {
    "redirect-uris": ["https://*.hana.ondemand.com/**", "http://localhost:5000/**"]
  }
}
