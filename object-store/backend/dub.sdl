name "object-store"
description "SAP BTP style Object Store service — D/vibe.d backend with REST, S3-like content API, OData v4, CLI and GtkD GUI"
homepage "https://github.com/UIMSolutions/uim/platform/object-store"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

targetPath "build"
sourcePaths "source"
importPaths "source"

// Core framework (brings uim-framework, vibe-d 0.10.x and gtk-d). Referenced by
// path, so the build does not depend on the repository root recipe.
dependency "service" path="../../service"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"

// ── HTTP server: REST + content API (/api/v1/object-store) + OData v4 (/odata/v4/object-store) + Fiori app
// dub build            (or --config=defaultRun)
// ./build/uim-object-store-platform-service
configuration "defaultRun" {
	targetType "executable"
	targetName "uim-object-store-platform-service"
	mainSourceFile "source/app.d"
	excludedSourceFiles "source/cli.d" "source/gui.d"
}

// ── Command line interface ──────────────────────────────────────────────────
// dub build --config=cli
// ./build/uim-object-store-cli help
configuration "cli" {
	targetType "executable"
	targetName "uim-object-store-cli"
	mainSourceFile "source/cli.d"
	excludedSourceFiles "source/app.d" "source/gui.d"
}

// ── Desktop GUI (GtkD 3 / GTK 3.24) ─────────────────────────────────────────
// dub build --config=gui
// ./build/uim-object-store-gui [--tenant=<id>] [--data-dir=<dir>]
configuration "gui" {
	targetType "executable"
	targetName "uim-object-store-gui"
	mainSourceFile "source/gui.d"
	excludedSourceFiles "source/app.d" "source/cli.d"
	dependency "gtk-d" version="~>3.11.0"
}

// ── Libraries / unit tests ──────────────────────────────────────────────────
// dub test --config=defaultTest
configuration "defaultTest" {
	targetType "library"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}
