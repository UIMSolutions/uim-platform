name "application-studio"
description "SAP Business Application Studio style service — dev spaces, extensions, templates, projects, service bindings, run and build configurations; D/vibe.d backend with REST, OData v4, CLI and GtkD GUI"
homepage "https://github.com/UIMSolutions/uim/platform/application-studio"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

targetPath "build"
sourcePaths "source"
importPaths "source"

// Core framework (brings uim-framework, vibe-d 0.10.x and gtk-d)
dependency "uim-platform:service" path="../.."

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"

// ── HTTP server: REST (/api/v1) + OData v4 (/odata/v4/application-studio) + Fiori app
// dub build            (or --config=defaultRun)
// ./build/uim-application-studio-platform-service
configuration "defaultRun" {
	targetType "executable"
	targetName "uim-application-studio-platform-service"
	mainSourceFile "source/app.d"
	excludedSourceFiles "source/cli.d" "source/gui.d"
}

// ── Command line interface ──────────────────────────────────────────────────
// dub build --config=cli
// ./build/uim-studio-cli help
configuration "cli" {
	targetType "executable"
	targetName "uim-studio-cli"
	mainSourceFile "source/cli.d"
	excludedSourceFiles "source/app.d" "source/gui.d"
}

// ── Desktop GUI (GtkD 3 / GTK 3.24) ─────────────────────────────────────────
// dub build --config=gui
// ./build/uim-studio-gui [--tenant=<id>] [--data-dir=<dir>]
configuration "gui" {
	targetType "executable"
	targetName "uim-studio-gui"
	mainSourceFile "source/gui.d"
	excludedSourceFiles "source/app.d" "source/cli.d"
	dependency "gtk-d" version="~>3.11.0"
}

// ── Libraries / unit tests ──────────────────────────────────────────────────
// dub test --config=defaultTest
configuration "defaultTest" {
	targetType "library"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}
