{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/odata/v4/abap-environment/(.*)$",
      "target": "/odata/v4/abap-environment/$1",
      "destination": "abap-environment-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.AbapViewer", "$XSAPPNAME.AbapDeveloper", "$XSAPPNAME.AbapAdmin"],
        "default": ["$XSAPPNAME.AbapDeveloper", "$XSAPPNAME.AbapAdmin"]
      }
    },
    {
      "source": "^/api/v1/(.*)$",
      "target": "/api/v1/$1",
      "destination": "abap-environment-srv",
      "authenticationType": "xsuaa",
      "csrfProtection": true,
      "scope": {
        "GET": ["$XSAPPNAME.AbapViewer", "$XSAPPNAME.AbapDeveloper", "$XSAPPNAME.AbapAdmin"],
        "default": ["$XSAPPNAME.AbapDeveloper", "$XSAPPNAME.AbapAdmin"]
      }
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.AbapViewer", "$XSAPPNAME.AbapDeveloper", "$XSAPPNAME.AbapAdmin"]
    }
  ]
}
