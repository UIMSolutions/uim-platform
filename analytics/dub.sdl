name "analytics"
description "Analytics Service inspired by SAP Analytics Cloud capability areas"
authors "Ozan Nurettin Suel"
copyright "Copyright (c) 2018-2026, Ozan Nurettin Suel"
license "Apache-2.0"

// Target settings
targetType "executable"
targetName "uim-analytics-platform-service"
targetPath "build"

// Source and import paths
sourcePaths "source"
importPaths "source"

// Dependency on the core framework
dependency "uim-platform:service" path=".."

// Build settings
configuration "defaultRun" {
    targetType "executable"
}

configuration "defaultTest" {
    targetType "library"
}

configuration "modules" {
    targetType "library"
    versions "show_module"
}

configuration "tests" {
    targetType "library"
    versions "show_module" "show_test"
}

configuration "inits" {
    targetType "library"
    versions "show_module" "show_init"
}

configuration "calls" {
    targetType "library"
    versions "show_module" "show_calls"
}

configuration "verbose" {
    targetType "library"
    versions "show_module" "show_test" "show_init" "show_calls"
}
