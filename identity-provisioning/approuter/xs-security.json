{
  "xsappname": "uim-identity-provisioning",
  "tenant-mode": "dedicated",
  "description": "UIM Identity Provisioning service",
  "scopes": [
    { "name": "$XSAPPNAME.ProvisioningViewer", "description": "Read systems, transformations, jobs, provisioned entities and logs" },
    { "name": "$XSAPPNAME.ProvisioningOperator", "description": "Run, cancel and resume jobs, test connections, preview transformations" },
    { "name": "$XSAPPNAME.ProvisioningAdmin", "description": "Maintain systems (incl. credentials), transformations and jobs, purge logs" }
  ],
  "role-templates": [
    { "name": "ProvisioningViewer", "description": "Identity provisioning viewer", "scope-references": ["$XSAPPNAME.ProvisioningViewer"] },
    { "name": "ProvisioningOperator", "description": "Identity provisioning operator",
      "scope-references": ["$XSAPPNAME.ProvisioningOperator", "$XSAPPNAME.ProvisioningViewer"] },
    { "name": "ProvisioningAdmin", "description": "Identity provisioning administrator",
      "scope-references": ["$XSAPPNAME.ProvisioningAdmin", "$XSAPPNAME.ProvisioningOperator", "$XSAPPNAME.ProvisioningViewer"] }
  ],
  "role-collections": [
    { "name": "UIM Identity Provisioning Viewer", "role-template-references": ["$XSAPPNAME.ProvisioningViewer"] },
    { "name": "UIM Identity Provisioning Operator", "role-template-references": ["$XSAPPNAME.ProvisioningOperator"] },
    { "name": "UIM Identity Provisioning Administrator", "role-template-references": ["$XSAPPNAME.ProvisioningAdmin"] }
  ],
  "oauth2-configuration": {
    "redirect-uris": ["https://*.hana.ondemand.com/**", "http://localhost:5000/**"]
  }
}
