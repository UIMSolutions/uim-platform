<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">
  <Dialog id="previewDialog" title="{i18n>previewTitle} — {ui>/preview/name}" contentWidth="44rem" resizable="true" draggable="true">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="{i18n>lblEntityType}"/>
        <SegmentedButton selectedKey="{ui>/preview/entityType}">
          <items>
            <SegmentedButtonItem key="user" text="User"/>
            <SegmentedButtonItem key="group" text="Group"/>
          </items>
        </SegmentedButton>
        <Label text="{i18n>lblSampleAttributes}" class="sapUiSmallMarginTop"/>
        <TextArea id="previewInput" value="{ui>/preview/input}" rows="6" width="100%" growing="true"/>
        <MessageStrip visible="{= !!${ui>/preview/result} }" showIcon="true" class="sapUiSmallMarginTop"
          type="{= ${ui>/preview/result/accepted} ? 'Success' : ${ui>/preview/result/failed} ? 'Error' : 'Warning' }"
          text="{= ${ui>/preview/result/accepted} ? ${i18n>previewAccepted} : ${ui>/preview/result/failed} ? ${i18n>previewFailed} : ${i18n>previewFiltered} } {ui>/preview/result/reason}"/>
        <Table id="previewResultTable" items="{ui>/preview/result/attributes}" visible="{= !!${ui>/preview/result} }"
          noDataText="{i18n>noAttributes}" class="sapUiSmallMarginTop">
          <columns>
            <Column><Text text="{i18n>colTargetAttribute}"/></Column>
            <Column><Text text="{i18n>colValue}"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{ui>key}"/>
                <Text text="{ui>value}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
    <beginButton>
      <Button id="runPreviewButton" text="{i18n>runPreview}" type="Emphasized" press=".onRunPreview"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>close}" press=".onClosePreview"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
