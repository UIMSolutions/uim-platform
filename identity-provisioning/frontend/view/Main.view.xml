<mvc:View
  controllerName="uim.identityprovisioning.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:l="sap.ui.layout"
  xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
  xmlns="sap.m">
  <!-- One tab per OData entity set; actions call unbound OData actions -->
  <f:DynamicPage id="mainPage" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="{i18n>appTitle}" level="H2"/>
        </f:heading>
        <f:snappedContent>
          <Text text="{i18n>appDescription}"/>
        </f:snappedContent>
        <f:actions>
          <Button id="runDueJobsButton" text="{i18n>runDueJobs}" icon="sap-icon://process" press=".onRunDueJobs"/>
          <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <!-- KPI header bound to the Statistics singleton -->
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox id="kpiHeader" wrap="Wrap" binding="{/Statistics}">
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSources}"/>
            <ObjectNumber number="{sourceSystemsActive} / {sourceSystems}" unit="{i18n>kpiActive}" class="sapMObjectNumberLarge"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiTargets}"/>
            <ObjectNumber number="{targetSystemsActive} / {targetSystems}" unit="{i18n>kpiActive}" class="sapMObjectNumberLarge"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSystemsInError}"/>
            <ObjectNumber number="{systemsInError}" class="sapMObjectNumberLarge" state="{= %{systemsInError} > 0 ? 'Error' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiJobs}"/>
            <ObjectNumber number="{jobs}" unit="{jobsScheduled} {i18n>kpiScheduled}" class="sapMObjectNumberLarge"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiJobsFailed}"/>
            <ObjectNumber number="{jobsFailed}" class="sapMObjectNumberLarge" state="{= %{jobsFailed} > 0 ? 'Error' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiUsers}"/>
            <ObjectNumber number="{provisionedUsers}" class="sapMObjectNumberLarge"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiGroups}"/>
            <ObjectNumber number="{provisionedGroups}" class="sapMObjectNumberLarge"/>
          </VBox>
          <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiEntityErrors}"/>
            <ObjectNumber number="{provisionedErrors}" class="sapMObjectNumberLarge" state="{= %{provisionedErrors} > 0 ? 'Warning' : 'None' }"/>
          </VBox>
          <VBox class="sapUiSmallMarginBottom">
            <Label text="{i18n>kpiLastRun}"/>
            <Text text="{path: 'lastRunAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}" class="sapUiTinyMarginTop"/>
          </VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <IconTabBar id="tabs" selectedKey="{ui>/selectedTab}" select=".onTabSelect"
        expandable="false" headerMode="Inline" stretchContentHeight="false" class="sapUiResponsiveContentPadding">
        <items>

          <!-- ── Overview ─────────────────────────────────────────── -->
          <IconTabFilter key="overview" icon="sap-icon://business-objects-experience" text="{i18n>tabOverview}">
            <l:Grid defaultSpan="XL3 L4 M6 S12" binding="{/Statistics}">
              <GenericTile header="{i18n>tabSources}" subheader="{i18n>kpiActive}: {sourceSystemsActive}" press=".onTile" app:tab="sources">
                <TileContent><NumericContent value="{sourceSystems}" icon="sap-icon://download-from-cloud" withMargin="false"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabTargets}" subheader="{i18n>kpiActive}: {targetSystemsActive}" press=".onTile" app:tab="targets">
                <TileContent><NumericContent value="{targetSystems}" icon="sap-icon://upload-to-cloud" withMargin="false"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabProxies}" subheader="{i18n>kpiActive}: {proxySystemsActive}" press=".onTile" app:tab="proxies">
                <TileContent><NumericContent value="{proxySystems}" icon="sap-icon://chain-link" withMargin="false"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabTransformations}" subheader="{i18n>kpiActive}: {transformationsActive}" press=".onTile" app:tab="transformations">
                <TileContent><NumericContent value="{transformations}" icon="sap-icon://combine" withMargin="false"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabJobs}" subheader="{i18n>kpiRuns}: {runs} · {i18n>kpiJobsFailed}: {jobsFailed}" press=".onTile" app:tab="jobs">
                <TileContent><NumericContent value="{jobs}" icon="sap-icon://process" withMargin="false"
                  valueColor="{= %{jobsFailed} > 0 ? 'Error' : 'Neutral' }"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabEntities}" subheader="{i18n>kpiUsers}: {provisionedUsers} · {i18n>kpiGroups}: {provisionedGroups}" press=".onTile" app:tab="entities">
                <TileContent><NumericContent value="{provisionedEntities}" icon="sap-icon://group" withMargin="false"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabLogs}" subheader="{i18n>kpiFailedEntries}: {logsFailed}" press=".onTile" app:tab="logs">
                <TileContent><NumericContent value="{logs}" icon="sap-icon://activity-items" withMargin="false"
                  valueColor="{= %{logsFailed} > 0 ? 'Critical' : 'Neutral' }"/></TileContent>
              </GenericTile>
              <GenericTile header="{i18n>tabSystemTypes}" subheader="{i18n>tabSystemTypesSub}" press=".onTile" app:tab="systemTypes">
                <TileContent><ImageContent src="sap-icon://it-system"/></TileContent>
              </GenericTile>
            </l:Grid>
          </IconTabFilter>

          <!-- ── SourceSystems ── -->
          <IconTabFilter key="sources" icon="sap-icon://download-from-cloud" text="{i18n>tabSources}" >
            <Table id="sourceTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/SourceSystems', parameters: {$count: true, $orderby: 'name'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabSources}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch('sourceTable', 'name', $event)"/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreate('SourceSystems')"/>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit('sourceTable')"/>
                  <Button text="{i18n>testConnection}" icon="sap-icon://connected" press=".onAction('sourceTable', 'TestConnectionSourceSystem')"/>
                  <Button text="{i18n>activate}" icon="sap-icon://activate" press=".onAction('sourceTable', 'ActivateSourceSystem')"/>
                  <Button text="{i18n>deactivate}" press=".onAction('sourceTable', 'DeactivateSourceSystem')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('sourceTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colAuthentication}"/></Column>
                <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colEntities}"/></Column>
                <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastSync}"/></Column>
                <Column width="9rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <Text text="{path: 'systemType', formatter: '.formatter.enumText'}"/>
                    <Text text="{url}" wrapping="false"/>
                    <Text text="{path: 'authenticationType', formatter: '.formatter.enumText'}"/>
                    <ObjectNumber number="{entityCount}"/>
                    <Text text="{path: 'lastSyncAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                      icon="{path: 'status', formatter: '.formatter.statusIcon'}" tooltip="{statusMessage}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── TargetSystems ── -->
          <IconTabFilter key="targets" icon="sap-icon://upload-to-cloud" text="{i18n>tabTargets}" >
            <Table id="targetTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/TargetSystems', parameters: {$count: true, $orderby: 'name'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabTargets}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch('targetTable', 'name', $event)"/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreate('TargetSystems')"/>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit('targetTable')"/>
                  <Button text="{i18n>testConnection}" icon="sap-icon://connected" press=".onAction('targetTable', 'TestConnectionTargetSystem')"/>
                  <Button text="{i18n>activate}" icon="sap-icon://activate" press=".onAction('targetTable', 'ActivateTargetSystem')"/>
                  <Button text="{i18n>deactivate}" press=".onAction('targetTable', 'DeactivateTargetSystem')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('targetTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colAuthentication}"/></Column>
                <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colEntities}"/></Column>
                <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastSync}"/></Column>
                <Column width="9rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <Text text="{path: 'systemType', formatter: '.formatter.enumText'}"/>
                    <Text text="{url}" wrapping="false"/>
                    <Text text="{path: 'authenticationType', formatter: '.formatter.enumText'}"/>
                    <ObjectNumber number="{entityCount}"/>
                    <Text text="{path: 'lastSyncAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                      icon="{path: 'status', formatter: '.formatter.statusIcon'}" tooltip="{statusMessage}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── ProxySystems ── -->
          <IconTabFilter key="proxies" icon="sap-icon://chain-link" text="{i18n>tabProxies}" >
            <Table id="proxyTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/ProxySystems', parameters: {$count: true, $orderby: 'name'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabProxies}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch('proxyTable', 'name', $event)"/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreate('ProxySystems')"/>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit('proxyTable')"/>
                  <Button text="{i18n>testConnection}" icon="sap-icon://connected" press=".onAction('proxyTable', 'TestConnectionProxySystem')"/>
                  <Button text="{i18n>activate}" icon="sap-icon://activate" press=".onAction('proxyTable', 'ActivateProxySystem')"/>
                  <Button text="{i18n>deactivate}" press=".onAction('proxyTable', 'DeactivateProxySystem')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('proxyTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colAuthentication}"/></Column>
                <Column width="6rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colEntities}"/></Column>
                <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastSync}"/></Column>
                <Column width="9rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <Text text="{path: 'systemType', formatter: '.formatter.enumText'}"/>
                    <Text text="{url}" wrapping="false"/>
                    <Text text="{path: 'authenticationType', formatter: '.formatter.enumText'}"/>
                    <ObjectNumber number="{entityCount}"/>
                    <Text text="{path: 'lastSyncAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                      icon="{path: 'status', formatter: '.formatter.statusIcon'}" tooltip="{statusMessage}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Transformations ── -->
          <IconTabFilter key="transformations" icon="sap-icon://combine" text="{i18n>tabTransformations}">
            <Table id="transformationTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/Transformations', parameters: {$count: true, $orderby: 'systemName,sequence,name'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabTransformations}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="14rem" search=".onSearch('transformationTable', 'name', $event)"/>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreate('Transformations')"/>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit('transformationTable')"/>
                  <Button id="previewButton" text="{i18n>preview}" icon="sap-icon://show" press=".onPreview"/>
                  <Button text="{i18n>activate}" press=".onAction('transformationTable', 'ActivateTransformation')"/>
                  <Button text="{i18n>deactivate}" press=".onAction('transformationTable', 'DeactivateTransformation')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('transformationTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSystem}"/></Column>
                <Column width="6rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colScope}"/></Column>
                <Column width="4rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colSequence}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colMappings}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colConditions}"/></Column>
                <Column width="7rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <ObjectIdentifier title="{systemName}" text="{path: 'systemRole', formatter: '.formatter.enumText'}"/>
                    <Text text="{path: 'scope', formatter: '.formatter.enumText'}"/>
                    <Text text="{sequence}"/>
                    <Text text="{path: 'mappings', targetType: 'any', formatter: '.formatter.mappings'}" maxLines="3"/>
                    <Text text="{path: 'conditions', targetType: 'any', formatter: '.formatter.conditions'}"/>
                    <ObjectStatus text="{= ${active} ? ${i18n>stateActive} : ${i18n>stateInactive} }" state="{= ${active} ? 'Success' : 'None' }"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Jobs ── -->
          <IconTabFilter key="jobs" icon="sap-icon://process" text="{i18n>tabJobs}">
            <Table id="jobTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/ProvisioningJobs', parameters: {$count: true, $orderby: 'name'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabJobs}" level="H3"/>
                  <ToolbarSpacer/>
                  <Select width="10rem" change=".onFilter('jobTable', 'status', $event)">
                    <core:Item key="" text="{i18n>allStatuses}"/>
                    <core:Item key="scheduled" text="Scheduled"/>
                    <core:Item key="completed" text="Completed"/>
                    <core:Item key="failed" text="Failed"/>
                    <core:Item key="cancelled" text="Cancelled"/>
                  </Select>
                  <Button text="{i18n>create}" icon="sap-icon://add" press=".onCreate('ProvisioningJobs')"/>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit('jobTable')"/>
                  <Button id="runJobButton" text="{i18n>runNow}" icon="sap-icon://media-play" type="Emphasized" press=".onAction('jobTable', 'RunProvisioningJob')"/>
                  <Button text="{i18n>cancelJob}" press=".onAction('jobTable', 'CancelProvisioningJob')"/>
                  <Button text="{i18n>resume}" press=".onAction('jobTable', 'ResumeProvisioningJob')"/>
                  <Button text="{i18n>resetDelta}" icon="sap-icon://reset" press=".onAction('jobTable', 'ResetProvisioningJob')"/>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete('jobTable')"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="6rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}"/></Column>
                <Column width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSchedule}"/></Column>
                <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastRun}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colResult}"/></Column>
                <Column width="9rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onJobPress">
                  <cells>
                    <ObjectIdentifier title="{name}" text="{description}"/>
                    <Text text="{path: 'jobType', formatter: '.formatter.enumText'}"/>
                    <Text text="{path: 'intervalMinutes', formatter: '.formatter.interval'}"/>
                    <Text text="{path: 'completedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                    <Text text="{statusMessage}" maxLines="2"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                      icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Provisioned entities (read-only) ── -->
          <IconTabFilter key="entities" icon="sap-icon://group" text="{i18n>tabEntities}">
            <Table id="entityTable" growing="true" growingThreshold="100" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/ProvisionedEntities', parameters: {$count: true, $orderby: 'targetSystemName,entityType,name'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabEntities}" level="H3"/>
                  <ToolbarSpacer/>
                  <Select width="8rem" change=".onFilter('entityTable', 'entityType', $event)">
                    <core:Item key="" text="{i18n>allTypes}"/>
                    <core:Item key="user" text="User"/>
                    <core:Item key="group" text="Group"/>
                  </Select>
                  <Select width="9rem" change=".onFilter('entityTable', 'status', $event)">
                    <core:Item key="" text="{i18n>allStatuses}"/>
                    <core:Item key="active" text="Active"/>
                    <core:Item key="inactive" text="Inactive"/>
                    <core:Item key="error" text="Error"/>
                  </Select>
                  <SearchField width="14rem" search=".onSearch('entityTable', 'name', $event)"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colName}"/></Column>
                <Column width="6rem"><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colTarget}"/></Column>
                <Column width="9rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colTargetId}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colAttributes}"/></Column>
                <Column width="11rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colLastSync}"/></Column>
                <Column width="8rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{externalId}"/>
                    <Text text="{path: 'entityType', formatter: '.formatter.enumText'}"/>
                    <Text text="{targetSystemName}"/>
                    <Text text="{targetId}"/>
                    <Text text="{path: 'attributes', targetType: 'any', formatter: '.formatter.keyValues'}" maxLines="2"/>
                    <Text text="{path: 'lastSyncAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                      icon="{path: 'status', formatter: '.formatter.statusIcon'}" tooltip="{statusMessage}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Logs (read-only) ── -->
          <IconTabFilter key="logs" icon="sap-icon://activity-items" text="{i18n>tabLogs}">
            <Table id="logTable" growing="true" growingThreshold="100" sticky="ColumnHeaders,HeaderToolbar"
              items="{path: '/ProvisioningLogs', parameters: {$count: true, $orderby: 'createdAt desc'}}" noDataText="{i18n>noData}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabLogs}" level="H3"/>
                  <ToolbarSpacer/>
                  <Select width="9rem" change=".onFilter('logTable', 'status', $event)">
                    <core:Item key="" text="{i18n>allStatuses}"/>
                    <core:Item key="success" text="Success"/>
                    <core:Item key="failed" text="Failed"/>
                    <core:Item key="skipped" text="Skipped"/>
                    <core:Item key="simulated" text="Simulated"/>
                  </Select>
                  <SearchField width="14rem" search=".onSearch('logTable', 'entityName', $event)"/>
                  <Button text="{i18n>purgeLogs}" icon="sap-icon://delete" press=".onPurgeLogs"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="11rem"><Text text="{i18n>colTime}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colJob}"/></Column>
                <Column width="4rem" hAlign="End" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colRun}"/></Column>
                <Column><Text text="{i18n>colOperation}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colMessage}"/></Column>
                <Column width="8rem"><Text text="{i18n>colStatus}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{path: 'createdAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                    <Text text="{jobName}"/>
                    <Text text="{runNumber}"/>
                    <ObjectStatus text="{name}" icon="{path: 'operation', formatter: '.formatter.operationIcon'}"/>
                    <Text text="{message}" maxLines="2"/>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.statusState'}"
                      icon="{path: 'status', formatter: '.formatter.statusIcon'}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── System types (reference data) ── -->
          <IconTabFilter key="systemTypes" icon="sap-icon://it-system" text="{i18n>tabSystemTypes}">
            <Table id="systemTypeTable" items="{path: '/SystemTypes'}" noDataText="{i18n>noData}">
              <columns>
                <Column width="12rem"><Text text="{i18n>colName}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colDescription}"/></Column>
                <Column width="5rem" hAlign="Center"><Text text="{i18n>roleSource}"/></Column>
                <Column width="5rem" hAlign="Center"><Text text="{i18n>roleTarget}"/></Column>
                <Column width="5rem" hAlign="Center"><Text text="{i18n>roleProxy}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{name}" text="{id}"/>
                    <Text text="{description}"/>
                    <Text text="{path: 'sourceSupported', formatter: '.formatter.yesNo'}"/>
                    <Text text="{path: 'targetSupported', formatter: '.formatter.yesNo'}"/>
                    <Text text="{path: 'proxySupported', formatter: '.formatter.yesNo'}"/>
                    <Text text="{urlPattern}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
