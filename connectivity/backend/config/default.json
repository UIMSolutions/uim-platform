{
  "serviceName": "Connectivity Service",
  "host": "0.0.0.0",
  "port": 8088,
  "logLevel": "info",
  "storage": "file",
  "dataDir": "data",
  "defaultTenant": "default",
  "odataPath": "/odata/v4/connectivity",
  "healthCheckIntervalSeconds": 30,
  "healthCheckTenants": [
    "default"
  ],
  "heartbeatTimeoutSeconds": 300,
  "certificateWarningDays": 30,
  "maxLogEntries": 5000,
  "frontendDir": "../frontend"
}
