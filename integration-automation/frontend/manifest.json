{
  "_version": "1.59.0",
  "sap.app": {
    "id": "uim.integrationautomation",
    "type": "application",
    "i18n": {
      "bundleName": "uim.integrationautomation.i18n.i18n",
      "supportedLocales": ["", "de"],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "2.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/integration-automation/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://process"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "uim.integrationautomation.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "uim.integrationautomation.i18n.i18n",
          "supportedLocales": ["", "de"],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "uim.integrationautomation.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "name": "main", "pattern": ":tab:", "target": "main" },
        { "name": "workflow", "pattern": "workflows/{id}", "target": "workflow" },
        { "name": "scenario", "pattern": "scenarios/{id}", "target": "scenario" }
      ],
      "targets": {
        "main": { "id": "main", "name": "Main" },
        "workflow": { "id": "workflow", "name": "WorkflowDetail" },
        "scenario": { "id": "scenario", "name": "ScenarioDetail" }
      }
    }
  }
}
