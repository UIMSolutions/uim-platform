<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <!-- task operations on the selected row of the table "tasksTable" (Main and WorkflowDetail) -->
  <Button text="{i18n>start}" icon="sap-icon://media-play" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="tasksTable"/><core:CustomData key="action" value="StartTask"/><core:CustomData key="toast" value="taskChanged"/></customData></Button>
  <Button text="{i18n>complete}" type="Accept" icon="sap-icon://accept" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="tasksTable"/><core:CustomData key="action" value="CompleteTask"/><core:CustomData key="param" value="result"/><core:CustomData key="title" value="completeTask"/><core:CustomData key="label" value="result"/><core:CustomData key="toast" value="taskChanged"/></customData></Button>
  <Button text="{i18n>fail}" type="Reject" icon="sap-icon://decline" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="tasksTable"/><core:CustomData key="action" value="FailTask"/><core:CustomData key="param" value="errorMessage"/><core:CustomData key="required" value="true"/><core:CustomData key="title" value="failTask"/><core:CustomData key="label" value="errorMessage"/><core:CustomData key="toast" value="taskChanged"/></customData></Button>
  <Button text="{i18n>skip}" icon="sap-icon://media-forward" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="tasksTable"/><core:CustomData key="action" value="SkipTask"/><core:CustomData key="param" value="reason"/><core:CustomData key="required" value="true"/><core:CustomData key="title" value="skipTask"/><core:CustomData key="label" value="reason"/><core:CustomData key="toast" value="taskChanged"/></customData></Button>
  <Button text="{i18n>retry}" icon="sap-icon://refresh" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="tasksTable"/><core:CustomData key="action" value="RetryTask"/><core:CustomData key="toast" value="taskChanged"/></customData></Button>
  <Button text="{i18n>assign}" icon="sap-icon://employee-pane" press=".onAssign" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="tasksTable"/></customData></Button>
</core:FragmentDefinition>
