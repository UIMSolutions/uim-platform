<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>newWorkflow}" contentWidth="34rem">
    <MessageStrip text="{i18n>workflowHint}" type="Information" showIcon="true" class="sapUiSmallMargin"/>
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4">
      <Label text="{i18n>colScenario}" required="true"/>
      <ComboBox selectedKey="{view>/form/workflow/scenarioId}" width="100%"
        items="{path: '/Scenarios', parameters: {$orderby: 'name', $select: 'id,name,version,status'}, filters: [{path: 'status', operator: 'EQ', value1: 'active'}], templateShareable: false}">
        <core:ListItem key="{id}" text="{name}" additionalText="{version}"/>
      </ComboBox>
      <Label text="{i18n>colName}"/>
      <Input value="{view>/form/workflow/name}" placeholder="{i18n>workflowNamePlaceholder}"/>
      <Label text="{i18n>colDescription}"/>
      <TextArea value="{view>/form/workflow/description}" rows="2"/>
      <Label text="{i18n>colSourceSystem}"/>
      <ComboBox selectedKey="{view>/form/workflow/sourceSystemId}" showClearIcon="true" width="100%"
        items="{path: '/Systems', parameters: {$orderby: 'name', $select: 'id,name,systemType'}, templateShareable: false}">
        <core:ListItem key="{id}" text="{name}" additionalText="{path: 'systemType', formatter: '.formatter.enumText'}"/>
      </ComboBox>
      <Label text="{i18n>colTargetSystem}"/>
      <ComboBox selectedKey="{view>/form/workflow/targetSystemId}" showClearIcon="true" width="100%"
        items="{path: '/Systems', parameters: {$orderby: 'name', $select: 'id,name,systemType'}, templateShareable: false}">
        <core:ListItem key="{id}" text="{name}" additionalText="{path: 'systemType', formatter: '.formatter.enumText'}"/>
      </ComboBox>
      <Label text="{i18n>startNow}"/>
      <Switch state="{view>/form/workflow/start}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
