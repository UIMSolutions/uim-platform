<mvc:View controllerName="uim.integrationautomation.controller.Main"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core"
  height="100%">
  <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{i18n>appTitle}" level="H2"/></f:heading>
        <f:snappedContent><Text text="{i18n>appDescription}"/></f:snappedContent>
        <f:actions>
          <Button id="newWorkflowButton" text="{i18n>newWorkflow}" type="Emphasized" icon="sap-icon://begin" press=".onOpenDialog"
            visible="{session>/canExecute}"><customData><core:CustomData key="dialog" value="workflow"/></customData></Button>
          <Button text="{i18n>runAutomation}" icon="sap-icon://process" press=".onRunAutomation" visible="{session>/canExecute}"/>
          <Button id="seedButton" text="{i18n>seed}" icon="sap-icon://add-product" press=".onSeed"
            visible="{= %{/Statistics/scenarios} === 0 &amp;&amp; %{/Statistics/systems} === 0 &amp;&amp; %{session>/canManage} }"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
          <Button id="userButton" icon="sap-icon://person-placeholder" text="{session>/displayName}" type="Transparent"
            press=".onUserMenu" visible="{session>/authenticated}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <!-- KPI header bound to the Statistics singleton -->
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox id="kpis" binding="{/Statistics}" wrap="Wrap" alignItems="Center" class="sapUiSmallMarginBottom">
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiOpenWorkflows}"/>
            <ObjectNumber number="{openWorkflows}" unit="/ {maxOpenWorkflows} · {runningWorkflows} {i18n>kpiRunning}"
              state="{= %{maxOpenWorkflows} > 0 &amp;&amp; %{openWorkflows} >= %{maxOpenWorkflows} ? 'Error' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiFailedWorkflows}"/>
            <ObjectNumber number="{failedWorkflows}" unit="· {suspendedWorkflows} {i18n>kpiSuspended}"
              state="{= %{failedWorkflows} > 0 ? 'Error' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiReadyTasks}"/>
            <ObjectNumber number="{readyTasks}" unit="/ {openTasks} {i18n>kpiOpen}" state="{= %{readyTasks} > 0 ? 'Information' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiMyTasks}"/>
            <ObjectNumber number="{myOpenTasks}" state="{= %{myOpenTasks} > 0 ? 'Warning' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiSystems}"/>
            <ObjectNumber number="{reachableSystems}" unit="/ {systems} {i18n>kpiReachable}"
              state="{= %{unreachableSystems} > 0 ? 'Error' : 'None' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiScenarios}"/>
            <ObjectNumber number="{activeScenarios}" unit="/ {scenarios} {i18n>kpiActive}"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiFailures24h}"/>
            <ObjectNumber number="{failuresLast24h}" state="{= %{failuresLast24h} > 0 ? 'Error' : 'Success' }"/>
          </VBox>
          <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
            <Label text="{i18n>kpiCompletionRate}"/>
            <ObjectNumber number="{completionRate}" unit="% · {completedWorkflows} {i18n>kpiCompleted}"/>
          </VBox>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <IconTabBar id="tabs" selectedKey="{view>/tab}" select=".onTabSelect" expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <!-- ── Workflows (monitor) ──────────────────────────────────── -->
          <IconTabFilter key="workflows" icon="sap-icon://process" text="{i18n>tabWorkflows}" count="{/Statistics/openWorkflows}">
            <Table id="workflowsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noWorkflows}"
              items="{path: '/Workflows', parameters: {$orderby: 'createdAt desc', $count: true, $select: 'scenarioId'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabWorkflows}" level="H3"/>
                  <ToolbarSpacer/>
                  <SegmentedButton selectedKey="{view>/workflowStatus}" selectionChange=".onWorkflowFilter">
                    <items>
                      <SegmentedButtonItem key="" text="{i18n>all}"/>
                      <SegmentedButtonItem key="inProgress" icon="sap-icon://process" tooltip="{i18n>enum_inProgress}"/>
                      <SegmentedButtonItem key="planned" icon="sap-icon://appointment-2" tooltip="{i18n>enum_planned}"/>
                      <SegmentedButtonItem key="suspended" icon="sap-icon://pause" tooltip="{i18n>enum_suspended}"/>
                      <SegmentedButtonItem key="failed" icon="sap-icon://error" tooltip="{i18n>enum_failed}"/>
                      <SegmentedButtonItem key="completed" icon="sap-icon://sys-enter-2" tooltip="{i18n>enum_completed}"/>
                      <SegmentedButtonItem key="terminated" icon="sap-icon://stop" tooltip="{i18n>enum_terminated}"/>
                    </items>
                  </SegmentedButton>
                  <SearchField width="12rem" search=".onSearch"><customData><core:CustomData key="table" value="workflowsTable"/></customData></SearchField>
                  <Button text="{i18n>start}" icon="sap-icon://media-play" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="workflowsTable"/><core:CustomData key="action" value="StartWorkflow"/><core:CustomData key="toast" value="workflowChanged"/></customData></Button>
                  <Button text="{i18n>suspend}" icon="sap-icon://media-pause" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="workflowsTable"/><core:CustomData key="action" value="SuspendWorkflow"/><core:CustomData key="toast" value="workflowChanged"/></customData></Button>
                  <Button text="{i18n>resume}" icon="sap-icon://restart" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="workflowsTable"/><core:CustomData key="action" value="ResumeWorkflow"/><core:CustomData key="toast" value="workflowChanged"/></customData></Button>
                  <Button text="{i18n>terminate}" icon="sap-icon://stop" press=".onTaskAction" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="workflowsTable"/><core:CustomData key="action" value="TerminateWorkflow"/><core:CustomData key="param" value="reason"/><core:CustomData key="title" value="terminateWorkflow"/><core:CustomData key="label" value="reason"/><core:CustomData key="toast" value="workflowChanged"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canExecute}"><customData><core:CustomData key="table" value="workflowsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colWorkflow}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" width="14rem"><Text text="{i18n>colProgress}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colCurrentTask}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colSystems}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colStarted}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onWorkflowPress">
                  <ObjectIdentifier title="{name}" text="{scenarioName} {scenarioVersion}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.workflowState'}"
                    icon="{path: 'status', formatter: '.formatter.workflowIcon'}"/>
                  <ProgressIndicator percentValue="{progressPercent}" displayValue="{completedTasks} / {totalTasks}" showValue="true"
                    state="{path: 'status', formatter: '.formatter.progressState'}"/>
                  <Text text="{currentTaskName}"/>
                  <Text text="{parts: ['sourceSystemName', 'targetSystemName'], formatter: '.formatter.route'}"/>
                  <Text text="{path: 'startedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Tasks (inbox) ────────────────────────────────────────── -->
          <IconTabFilter key="tasks" icon="sap-icon://inbox" text="{i18n>tabTasks}" count="{/Statistics/readyTasks}">
            <Table id="tasksTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noTasks}"
              items="{path: '/WorkflowTasks', parameters: {$orderby: 'workflowName,sequenceNumber', $count: true, $select: 'workflowId,instructions,errorMessage'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabTasks}" level="H3"/>
                  <ToolbarSpacer/>
                  <SegmentedButton selectedKey="{view>/taskFilter}" selectionChange=".onTaskFilter">
                    <items>
                      <SegmentedButtonItem key="mine" text="{i18n>filterMine}"/>
                      <SegmentedButtonItem key="ready" text="{i18n>filterReady}"/>
                      <SegmentedButtonItem key="open" text="{i18n>filterOpen}"/>
                      <SegmentedButtonItem key="failed" text="{i18n>filterFailed}"/>
                      <SegmentedButtonItem key="all" text="{i18n>all}"/>
                    </items>
                  </SegmentedButton>
                  <SearchField width="12rem" search=".onSearch"><customData><core:CustomData key="table" value="tasksTable"/></customData></SearchField>
                  <core:Fragment fragmentName="uim.integrationautomation.fragment.TaskButtons" type="XML"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colTask}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colPriority}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colAssigned}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colWaitingFor}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onWorkflowPress">
                  <HBox alignItems="Center">
                    <core:Icon src="{path: 'taskType', formatter: '.formatter.typeIcon'}" tooltip="{path: 'taskType', formatter: '.formatter.enumText'}" class="sapUiTinyMarginEnd"/>
                    <ObjectIdentifier title="{name}" text="{workflowName}"/>
                  </HBox>
                  <VBox>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.taskState'}"
                      icon="{path: 'status', formatter: '.formatter.taskIcon'}" tooltip="{errorMessage}"/>
                    <ObjectStatus text="{i18n>ready}" state="Information" icon="sap-icon://flag" visible="{ready}"/>
                  </VBox>
                  <ObjectStatus text="{path: 'priority', formatter: '.formatter.enumText'}" state="{path: 'priority', formatter: '.formatter.priorityState'}"/>
                  <ObjectIdentifier title="{assignedTo}" text="{assignedRole}"/>
                  <Text text="{waitingFor}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Scenarios ────────────────────────────────────────────── -->
          <IconTabFilter key="scenarios" icon="sap-icon://workflow-tasks" text="{i18n>tabScenarios}" count="{/Statistics/scenarios}">
            <Table id="scenariosTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noScenarios}"
              items="{path: '/Scenarios', parameters: {$orderby: 'name', $count: true}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabScenarios}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch"><customData><core:CustomData key="table" value="scenariosTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="scenario"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="scenariosTable"/><core:CustomData key="dialog" value="scenario"/></customData></Button>
                  <Button text="{i18n>activate}" icon="sap-icon://activate" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="scenariosTable"/><core:CustomData key="action" value="ActivateScenario"/><core:CustomData key="toast" value="scenarioChanged"/></customData></Button>
                  <Button text="{i18n>deprecate}" icon="sap-icon://warning" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="scenariosTable"/><core:CustomData key="action" value="DeprecateScenario"/><core:CustomData key="toast" value="scenarioChanged"/></customData></Button>
                  <Button text="{i18n>archive}" icon="sap-icon://attachment-zip-file" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="scenariosTable"/><core:CustomData key="action" value="ArchiveScenario"/><core:CustomData key="toast" value="scenarioChanged"/></customData></Button>
                  <Button text="{i18n>copy}" icon="sap-icon://copy" press=".onTaskAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="scenariosTable"/><core:CustomData key="action" value="CopyScenario"/><core:CustomData key="param" value="newId"/><core:CustomData key="title" value="copyScenario"/><core:CustomData key="label" value="newId"/><core:CustomData key="toast" value="scenarioCopied"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="scenariosTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colScenario}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colCategory}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colSystemTypes}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colTemplates}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="{i18n>colWorkflows}"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onScenarioPress">
                  <ObjectIdentifier title="{name}" text="{id} · {version}"/>
                  <Text text="{path: 'category', formatter: '.formatter.enumText'}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.scenarioState'}"/>
                  <Text text="{parts: [{path: 'sourceSystemType', formatter: '.formatter.enumText'}, {path: 'targetSystemType', formatter: '.formatter.enumText'}], formatter: '.formatter.route'}"/>
                  <ObjectNumber number="{taskCount}" unit="{path: 'estimatedMinutes', formatter: '.formatter.minutes'}"/>
                  <ObjectNumber number="{workflowCount}" unit="{openWorkflowCount} {i18n>kpiOpen}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Systems ──────────────────────────────────────────────── -->
          <IconTabFilter key="systems" icon="sap-icon://it-host" text="{i18n>tabSystems}" count="{/Statistics/systems}">
            <Table id="systemsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noSystems}"
              items="{path: '/Systems', parameters: {$orderby: 'name', $count: true}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabSystems}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch"><customData><core:CustomData key="table" value="systemsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="system"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="systemsTable"/><core:CustomData key="dialog" value="system"/></customData></Button>
                  <Button text="{i18n>testConnection}" icon="sap-icon://connected" press=".onRowAction" visible="{session>/canManage}"><customData><core:CustomData key="table" value="systemsTable"/><core:CustomData key="action" value="TestSystemConnection"/><core:CustomData key="toast" value="systemTested"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="systemsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colSystem}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colSystemType}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colHost}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colEnvironment}"/></Column>
                <Column><Text text="{i18n>colConnection}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>colUsage}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{path: 'systemType', formatter: '.formatter.enumText'}"/>
                  <Text text="{protocol}://{host}:{port}"/>
                  <Text text="{path: 'environment', formatter: '.formatter.enumText'} {region}"/>
                  <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.connectionState'}"
                    icon="{path: 'status', formatter: '.formatter.connectionIcon'}" tooltip="{lastTestMessage}"/>
                  <Text text="{destinationCount} {i18n>colDestinations} · {openWorkflowCount} {i18n>colWorkflows}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Destinations ─────────────────────────────────────────── -->
          <IconTabFilter key="destinations" icon="sap-icon://chain-link" text="{i18n>tabDestinations}" count="{/Statistics/destinations}">
            <Table id="destinationsTable" mode="SingleSelectLeft" growing="true" growingThreshold="50" noDataText="{i18n>noDestinations}"
              items="{path: '/Destinations', parameters: {$orderby: 'name', $count: true, $select: 'description,systemId,locationId,user,tokenServiceUrl,audience,scope'}, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabDestinations}" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField width="12rem" search=".onSearch"><customData><core:CustomData key="table" value="destinationsTable"/></customData></SearchField>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog" visible="{session>/canManage}"><customData><core:CustomData key="dialog" value="destination"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEdit" visible="{session>/canManage}"><customData><core:CustomData key="table" value="destinationsTable"/><core:CustomData key="dialog" value="destination"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete" visible="{session>/canManage}"><customData><core:CustomData key="table" value="destinationsTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colDestination}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colType}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colUrl}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colAuthentication}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colSystem}"/></Column>
                <Column><Text text="{i18n>colEnabled}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{name}" text="{id}"/>
                  <Text text="{path: 'destinationType', formatter: '.formatter.enumText'} · {path: 'proxyType', formatter: '.formatter.enumText'}"/>
                  <Text text="{url}" wrapping="false"/>
                  <ObjectIdentifier title="{path: 'authentication', formatter: '.formatter.enumText'}" text="{authorizationVariable}"/>
                  <Text text="{systemName}"/>
                  <ObjectStatus icon="{= %{enabled} ? 'sap-icon://accept' : 'sap-icon://decline' }" state="{= %{enabled} ? 'Success' : 'None' }"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <!-- ── Execution log ────────────────────────────────────────── -->
          <IconTabFilter key="log" icon="sap-icon://activity-items" text="{i18n>tabLog}" count="{/Statistics/failuresLast24h}">
            <core:Fragment fragmentName="uim.integrationautomation.fragment.LogTable" type="XML"/>
          </IconTabFilter>

          <!-- ── Users of the built-in login (administrators) ──────────── -->
          <IconTabFilter key="users" icon="sap-icon://group" text="{i18n>tabUsers}" visible="{= %{session>/isAdmin} &amp;&amp; %{session>/loginRequired} }">
            <Table id="usersTable" mode="SingleSelectLeft" growing="true" noDataText="{i18n>noUsers}"
              items="{path: '/Users', parameters: {$orderby: 'id'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabUsers}" level="H3"/>
                  <ToolbarSpacer/>
                  <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onOpenDialog"><customData><core:CustomData key="dialog" value="user"/></customData></Button>
                  <Button text="{i18n>edit}" icon="sap-icon://edit" press=".onEditUser"/>
                  <Button text="{i18n>lock}" icon="sap-icon://locked" press=".onLockUser"><customData><core:CustomData key="locked" value="true"/></customData></Button>
                  <Button text="{i18n>unlock}" icon="sap-icon://unlocked" press=".onLockUser"><customData><core:CustomData key="locked" value="false"/></customData></Button>
                  <Button text="{i18n>delete}" icon="sap-icon://delete" press=".onDelete"><customData><core:CustomData key="table" value="usersTable"/></customData></Button>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="{i18n>colUser}"/></Column>
                <Column><Text text="{i18n>colScopes}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colLastLogin}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <ObjectIdentifier title="{id}" text="{displayName}"/>
                  <Text text="{scopesText}"/>
                  <ObjectStatus text="{= %{locked} ? ${i18n>locked} : %{temporarilyLocked} ? ${i18n>temporarilyLocked} : ${i18n>enabled} }"
                    state="{= %{locked} || %{temporarilyLocked} ? 'Error' : 'Success' }"/>
                  <Text text="{path: 'lastLoginAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
