<mvc:View controllerName="uim.integrationautomation.controller.WorkflowDetail"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout"
  height="100%">
  <f:DynamicPage id="workflowPage" headerExpanded="true" showFooter="false">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="{name}" wrapping="true"/></f:heading>
        <f:expandedContent><Link text="{scenarioName} {scenarioVersion}" press=".onScenarioPress"/></f:expandedContent>
        <f:snappedContent><ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.workflowState'}"/></f:snappedContent>
        <f:navigationActions>
          <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>close}" press=".onNavBack"/>
        </f:navigationActions>
        <f:actions>
          <Button text="{i18n>start}" type="Emphasized" icon="sap-icon://media-play" press=".onWorkflowAction"
            visible="{= %{session>/canExecute} &amp;&amp; %{status} === 'planned' }"><customData><core:CustomData key="action" value="StartWorkflow"/></customData></Button>
          <Button text="{i18n>suspend}" icon="sap-icon://media-pause" press=".onWorkflowAction"
            visible="{= %{session>/canExecute} &amp;&amp; (%{status} === 'inProgress' || %{status} === 'failed') }"><customData><core:CustomData key="action" value="SuspendWorkflow"/></customData></Button>
          <Button text="{i18n>resume}" type="Emphasized" icon="sap-icon://restart" press=".onWorkflowAction"
            visible="{= %{session>/canExecute} &amp;&amp; %{status} === 'suspended' }"><customData><core:CustomData key="action" value="ResumeWorkflow"/></customData></Button>
          <Button text="{i18n>runAutomation}" icon="sap-icon://process" press=".onRunAutomation"
            visible="{= %{session>/canExecute} &amp;&amp; %{status} === 'inProgress' }"/>
          <Button text="{i18n>terminate}" type="Reject" icon="sap-icon://stop" press=".onTerminate"
            visible="{= %{session>/canExecute} &amp;&amp; %{status} !== 'completed' &amp;&amp; %{status} !== 'terminated' }"/>
          <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <layout:HorizontalLayout allowWrapping="true">
          <layout:VerticalLayout class="sapUiMediumMarginEnd">
            <ObjectStatus title="{i18n>colStatus}" text="{path: 'status', formatter: '.formatter.enumText'}"
              state="{path: 'status', formatter: '.formatter.workflowState'}" icon="{path: 'status', formatter: '.formatter.workflowIcon'}"/>
            <ObjectAttribute title="{i18n>colCurrentTask}" text="{currentTaskName}"/>
            <ObjectAttribute title="{i18n>terminationReason}" text="{terminationReason}" visible="{= !!%{terminationReason} }"/>
          </layout:VerticalLayout>
          <layout:VerticalLayout class="sapUiMediumMarginEnd" width="16rem">
            <Label text="{i18n>colProgress}"/>
            <ProgressIndicator percentValue="{progressPercent}" displayValue="{progressPercent} % · {completedTasks} / {totalTasks}"
              showValue="true" state="{path: 'status', formatter: '.formatter.progressState'}"/>
            <ObjectAttribute title="{i18n>failedTasks}" text="{failedTasks}" visible="{= %{failedTasks} > 0 }"/>
          </layout:VerticalLayout>
          <layout:VerticalLayout class="sapUiMediumMarginEnd">
            <ObjectAttribute title="{i18n>colSourceSystem}" text="{sourceSystemName}"/>
            <ObjectAttribute title="{i18n>colTargetSystem}" text="{targetSystemName}"/>
          </layout:VerticalLayout>
          <layout:VerticalLayout class="sapUiMediumMarginEnd">
            <ObjectAttribute title="{i18n>colStarted}" text="{path: 'startedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
            <ObjectAttribute title="{i18n>colFinished}" text="{path: 'completedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {style: 'medium'}}"/>
            <ObjectAttribute title="{i18n>createdBy}" text="{createdBy}"/>
          </layout:VerticalLayout>
          <layout:VerticalLayout>
            <Text text="{description}" width="28rem" maxLines="4"/>
          </layout:VerticalLayout>
        </layout:HorizontalLayout>
      </f:DynamicPageHeader>
    </f:header>
    <f:content>
      <IconTabBar expandable="false" class="sapUiResponsiveContentPadding">
        <items>
          <IconTabFilter key="tasks" icon="sap-icon://task" text="{i18n>tabTasks}" count="{totalTasks}">
            <Table id="tasksTable" mode="SingleSelectLeft" noDataText="{i18n>noTasks}"
              items="{path: '/WorkflowTasks', parameters: {$orderby: 'sequenceNumber', $select: 'workflowId,dependsOn,attempts'}, suspended: true, templateShareable: false}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="{i18n>tabTasks}" level="H3"/>
                  <ToolbarSpacer/>
                  <core:Fragment fragmentName="uim.integrationautomation.fragment.TaskButtons" type="XML"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column width="4rem" hAlign="End"><Text text="#"/></Column>
                <Column><Text text="{i18n>colTask}"/></Column>
                <Column><Text text="{i18n>colStatus}"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colAssigned}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colResult}"/></Column>
                <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="{i18n>colDuration}"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <Text text="{sequenceNumber}"/>
                  <VBox>
                    <HBox alignItems="Center">
                      <core:Icon src="{path: 'taskType', formatter: '.formatter.typeIcon'}" tooltip="{path: 'taskType', formatter: '.formatter.enumText'}" class="sapUiTinyMarginEnd"/>
                      <Text text="{name}"/>
                    </HBox>
                    <Text text="{instructions}" maxLines="2" class="sapUiTinyMarginTop"/>
                    <Text text="{i18n>colWaitingFor}: {waitingFor}" visible="{= !!%{waitingFor} }" class="sapUiTinyMarginTop"/>
                  </VBox>
                  <VBox>
                    <ObjectStatus text="{path: 'status', formatter: '.formatter.enumText'}" state="{path: 'status', formatter: '.formatter.taskState'}"
                      icon="{path: 'status', formatter: '.formatter.taskIcon'}"/>
                    <ObjectStatus text="{i18n>ready}" state="Information" icon="sap-icon://flag" visible="{ready}"/>
                    <ObjectStatus text="{path: 'priority', formatter: '.formatter.enumText'}" state="{path: 'priority', formatter: '.formatter.priorityState'}"/>
                  </VBox>
                  <ObjectIdentifier title="{assignedTo}" text="{assignedRole}"/>
                  <VBox>
                    <Text text="{result}" maxLines="3"/>
                    <ObjectStatus text="{errorMessage}" state="Error" visible="{= !!%{errorMessage} }"/>
                    <Text text="{processedBy}" visible="{= !!%{processedBy} }"/>
                  </VBox>
                  <ObjectNumber number="{path: 'durationSeconds', formatter: '.formatter.duration'}"
                    unit="{= %{attempts} > 1 ? %{attempts} + ' ×' : '' }"/>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
          <IconTabFilter key="log" icon="sap-icon://activity-items" text="{i18n>tabLog}">
            <core:Fragment fragmentName="uim.integrationautomation.fragment.LogTable" type="XML"/>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </f:content>
  </f:DynamicPage>
</mvc:View>
