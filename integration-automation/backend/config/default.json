{
  "serviceName": "uim-integration-automation",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8090,
  "storage": "file",
  "dataFile": "data/integration-automation.json",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "odataPath": "/odata/v4/integration-automation",
  "maxPageSize": 200,
  "maxRequestBytes": 4194304,
  "authMode": "jwt",
  "jwtSecret": "",
  "tokenTtlSeconds": 3600,
  "adminUser": "admin",
  "adminPassword": "",
  "passwordIterations": 120000,
  "maxFailedLogins": 5,
  "lockSeconds": 900,
  "minPasswordLength": 10,
  "maxOpenWorkflows": 15,
  "frontendDir": "../frontend",
  "workerIntervalSeconds": 5,
  "workerTenants": [
    "default"
  ],
  "automationMode": "simulate",
  "automationTimeoutSeconds": 30,
  "notificationWebhookUrl": "",
  "connectivityMode": "simulate",
  "connectivityTimeoutSeconds": 10,
  "logRetentionDays": 90
}
