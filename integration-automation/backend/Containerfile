# Podman/Buildah: identical to the Dockerfile.
# Build context: the uim-platform repository root (the backend depends on
# the shared "service" package via a path dependency):
#   docker build -f integration-automation/backend/Dockerfile -t uim-platform/integration-automation .
FROM dlang2/ldc-ubuntu:1.40.1 AS build
WORKDIR /build
COPY . .
WORKDIR /build/integration-automation/backend
RUN dub build --build=release --config=defaultRun --compiler=ldc2 \
 && dub build --build=release --config=cli --compiler=ldc2

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false appuser && mkdir -p /data && chown appuser:appuser /data
WORKDIR /app
COPY --from=build /build/integration-automation/backend/build/uim-integration-automation-platform-service /build/integration-automation/backend/build/uim-integration-automation-cli ./
COPY --from=build /build/integration-automation/backend/config ./config
COPY --from=build /build/integration-automation/frontend ./frontend
USER appuser

EXPOSE 8090
# Built-in login: set IA_JWT_SECRET (>= 32 characters) and IA_ADMIN_PASSWORD,
# e.g. from a Kubernetes secret (see k8s/secret.example.yaml).
ENV IA_HOST=0.0.0.0 \
    IA_PORT=8090 \
    IA_STORAGE=file \
    IA_DATA_FILE=/data/integration-automation.json \
    IA_FRONTEND_DIR=/app/frontend \
    IA_AUTH_MODE=jwt
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8090/health || exit 1

CMD ["./uim-integration-automation-platform-service"]
