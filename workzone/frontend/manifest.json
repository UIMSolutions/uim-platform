{
  "_version": "1.60.0",
  "sap.app": {
    "id": "uim.workzone",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/workzone/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "workzone-manage": {
          "semanticObject": "WorkZone",
          "action": "manage",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "icons": { "icon": "sap-icon://collaborate" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "uim.workzone.view.App",
      "type": "XML",
      "id": "root"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.uxap": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "uim.workzone.i18n.i18n", "supportedLocales": ["", "de"], "fallbackLocale": "" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "autoExpandSelect": true,
          "operationMode": "Server",
          "groupId": "$direct",
          "updateGroupId": "$direct"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "uim.workzone.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "pattern": "", "name": "overview", "target": "overview" },
        { "pattern": "r/{set}", "name": "resource", "target": "resource" },
        { "pattern": "Workspaces/{id}", "name": "workspace", "target": "workspace" }
      ],
      "targets": {
        "overview": { "id": "overview", "name": "Overview", "level": 1 },
        "resource": { "id": "resource", "name": "Resource", "level": 2 },
        "workspace": { "id": "workspace", "name": "WorkspaceDetail", "level": 3 }
      }
    }
  }
}
