<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>testToken}" contentWidth="36rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3">
      <Label text="{i18n>colClientId}" required="true"/>
      <Input value="{view>/form/testToken/clientId}"/>
      <Label text="{i18n>colClientSecret}" required="true"/>
      <Input value="{view>/form/testToken/clientSecret}" type="Password"/>
      <Label text="{i18n>colScopes}"/>
      <Input value="{view>/form/testToken/scope}" placeholder="orders.read billing.read"/>
      <Label text="{i18n>colAccessToken}" visible="{= !!${view>/token} }"/>
      <TextArea value="{view>/token/accessToken}" rows="4" editable="false" visible="{= !!${view>/token} }"/>
      <Label text="{i18n>colScopes}" visible="{= !!${view>/token} }"/>
      <Text text="{view>/token/scope} · {view>/token/expiresIn} s" visible="{= !!${view>/token} }"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>requestToken}" type="Emphasized" press=".onRequestToken"/></beginButton>
    <endButton><Button text="{i18n>close}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
