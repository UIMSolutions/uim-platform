<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createScope}" contentWidth="28rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
      <Label text="{i18n>colApplication}" required="true"/>
      <Input value="{view>/form/scope/applicationId}" placeholder="orders"/>
      <Label text="{i18n>colScope}" required="true"/>
      <Input value="{view>/form/scope/name}" placeholder="orders.read"/>
      <Label text="{i18n>colDescription}"/>
      <Input value="{view>/form/scope/description}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
