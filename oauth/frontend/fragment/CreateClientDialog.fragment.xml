<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>createClient}" contentWidth="36rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4">
      <Label text="{i18n>colName}" required="true"/>
      <Input value="{view>/form/client/name}"/>
      <Label text="{i18n>colClientId}"/>
      <Input value="{view>/form/client/clientId}" placeholder="{i18n>generated}"/>
      <Label text="{i18n>colClientType}"/>
      <SegmentedButton selectedKey="{view>/form/client/clientType}">
        <items>
          <SegmentedButtonItem key="confidential" text="{i18n>confidential}" icon="sap-icon://locked"/>
          <SegmentedButtonItem key="public" text="{i18n>public}" icon="sap-icon://iphone"/>
        </items>
      </SegmentedButton>
      <Label text="{i18n>colGrantTypes}"/>
      <MultiComboBox selectedKeys="{view>/form/client/grantTypes}">
        <core:Item key="authorization_code" text="Authorization Code"/>
        <core:Item key="client_credentials" text="Client Credentials" enabled="{= ${view>/form/client/clientType} === 'confidential' }"/>
        <core:Item key="refresh_token" text="Refresh Token"/>
      </MultiComboBox>
      <Label text="{i18n>colAllowedScopes}"/>
      <MultiComboBox selectedKeys="{view>/form/client/allowedScopes}" items="{path: '/OAuthScopes', parameters: {$orderby: 'name'}}">
        <core:Item key="{name}" text="{name}" additionalText="{applicationId}"/>
      </MultiComboBox>
      <Label text="{i18n>colRedirectUris}"/>
      <TextArea value="{view>/form/client/redirectUris}" rows="2" placeholder="https://app.example.com/callback"/>
      <Label text="{i18n>colAccessTokenValidity}"/>
      <StepInput value="{view>/form/client/accessTokenValidity}" min="60" max="86400" step="60" largerStep="60" width="100%"/>
      <Label text="{i18n>colRefreshTokenValidity}"/>
      <StepInput value="{view>/form/client/refreshTokenValidity}" min="60" max="31536000" step="60" largerStep="60" width="100%"/>
      <Label text="{i18n>colContacts}"/>
      <Input value="{view>/form/client/contacts}" placeholder="team@example.com"/>
      <Label text="{i18n>colDescription}"/>
      <Input value="{view>/form/client/description}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>create}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
