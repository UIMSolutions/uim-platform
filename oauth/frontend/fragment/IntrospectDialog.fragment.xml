<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>introspect}" contentWidth="36rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3">
      <Label text="{i18n>colToken}" required="true"/>
      <TextArea value="{view>/form/introspect/token}" rows="3"/>
      <Label text="{i18n>colTokenType}"/>
      <Select selectedKey="{view>/form/introspect/tokenTypeHint}">
        <core:Item key="" text="{i18n>auto}"/>
        <core:Item key="access_token" text="Access Token"/>
        <core:Item key="refresh_token" text="Refresh Token"/>
      </Select>
    </form:SimpleForm>
    <form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanM="3" visible="{= !!${view>/introspection} }">
      <Label text="{i18n>colActive}"/>
      <ObjectStatus text="{= ${view>/introspection/active} ? 'active' : 'inactive' }" state="{= ${view>/introspection/active} ? 'Success' : 'Error' }"/>
      <Label text="{i18n>colStatus}"/>
      <Text text="{view>/introspection/status}"/>
      <Label text="{i18n>colClient}"/>
      <Text text="{view>/introspection/clientId}"/>
      <Label text="{i18n>colUser}"/>
      <Text text="{view>/introspection/userId}"/>
      <Label text="{i18n>colScopes}"/>
      <Text text="{view>/introspection/scope}"/>
      <Label text="{i18n>colExpiresAt}"/>
      <Text text="{view>/introspection/expiresAt}"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>introspect}" type="Emphasized" press=".onIntrospect"/></beginButton>
    <endButton><Button text="{i18n>close}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
