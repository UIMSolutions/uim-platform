<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <Dialog title="{i18n>secretTitle}" contentWidth="34rem" type="Message" state="Warning" escapeHandler=".onCloseSecret">
    <VBox class="sapUiSmallMargin">
      <MessageStrip text="{i18n>secretOnce}" type="Warning" showIcon="true" class="sapUiSmallMarginBottom"/>
      <form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanM="3">
        <Label text="{i18n>colClientId}"/>
        <Text text="{view>/secret/clientId}"/>
        <Label text="{i18n>colClientSecret}"/>
        <Input value="{view>/secret/clientSecret}" editable="false"/>
        <Label text="{i18n>revokedTokens}" visible="{= ${view>/secret/revokedTokens} > 0 }"/>
        <Text text="{view>/secret/revokedTokens}" visible="{= ${view>/secret/revokedTokens} > 0 }"/>
      </form:SimpleForm>
    </VBox>
    <buttons>
      <Button text="{i18n>copy}" icon="sap-icon://copy" press=".onCopySecret"/>
      <Button text="{i18n>secretStored}" type="Emphasized" press=".onCloseSecret"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
