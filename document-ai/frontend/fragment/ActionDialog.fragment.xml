<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
  <!-- an operation that takes one text: reject (reason) -->
  <Dialog title="{view>/form/action/title}" contentWidth="30rem">
    <form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="3" labelSpanL="3">
      <Label text="{i18n>colDocument}"/>
      <Text text="{view>/form/action/name}"/>
      <Label text="{view>/form/action/label}" required="{view>/form/action/required}"/>
      <TextArea value="{view>/form/action/text}" rows="3" growing="true" width="100%"/>
    </form:SimpleForm>
    <beginButton><Button text="{i18n>ok}" type="Emphasized" press=".onSave"/></beginButton>
    <endButton><Button text="{i18n>cancel}" press=".onCloseDialog"/></endButton>
  </Dialog>
</core:FragmentDefinition>
