{
  "serviceName": "uim-document-ai",
  "serviceVersion": "2.0.0",
  "host": "0.0.0.0",
  "port": 8096,
  "storage": "file",
  "dataFile": "data/document-ai.json",
  "defaultTenant": "default",
  "apiPath": "/api/v1",
  "odataPath": "/odata/v4/document-ai",
  "maxPageSize": 200,
  "maxRequestBytes": 4194304,
  "authMode": "jwt",
  "jwtSecret": "",
  "tokenTtlSeconds": 3600,
  "adminUser": "admin",
  "adminPassword": "",
  "passwordIterations": 120000,
  "maxFailedLogins": 5,
  "lockSeconds": 900,
  "minPasswordLength": 10,
  "minConfidence": 0.7,
  "minTrainingDocuments": 3,
  "trainingSeconds": 30,
  "maxDocumentsPerRun": 50,
  "frontendDir": "../frontend",
  "workerIntervalSeconds": 5,
  "workerTenants": ["default"],
  "extractionMode": "simulate",
  "extractionUrl": "",
  "extractionTimeoutSeconds": 60
}
